---
import { Image } from 'astro:assets';
import { getCollection, type CollectionEntry } from 'astro:content';
import ArticleCard from '../components/ArticleCard.astro';
import BaseHead from '../components/BaseHead.astro';
import BlogGenreNav from '../components/BlogGenreNav.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import ShareButtons from '../components/ShareButtons.astro';
import WebApps from '../components/WebApps.astro';
import { COMPANY_URL, TOOLBOX_URL } from '../consts';
import { countPostsByGenre, getBlogGenre } from '../lib/blogNavigation';

type PostData = CollectionEntry<'blog'>['data'];
type ArticleHeading = { depth: number; slug: string; text: string };
type Props = PostData & { postId: string; readingMinutes: number; headings: ArticleHeading[] };

const { title, description, pubDate, updatedDate, category, postId, readingMinutes, heroImage, headings } = Astro.props;
const articleHeadings = headings.filter((heading) => heading.depth === 2);
const allPosts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const currentGenre = getBlogGenre(category);
const otherPosts = allPosts.filter((post) => post.id !== postId);
const recommendedPosts = [
	...otherPosts.filter((post) => getBlogGenre(post.data.category) === currentGenre),
	...otherPosts.filter((post) => getBlogGenre(post.data.category) !== currentGenre),
].slice(0, 3);
const genreCounts = countPostsByGenre(allPosts);
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead title={`${title}｜玉城祐輔`} description={description} image={heroImage} imageAlt={title} type="article" />
	</head>
	<body>
		<Header />
		<main id="main-content">
			<article>
				<header class="article-hero">
					<div class="shell article-hero-inner">
						<div class="article-copy">
							<a class="back-link" href="/blog">記事一覧へ戻る</a>
							<p class="category">{category}</p>
							<h1>{title}</h1>
							<p class="description">{description}</p>
							<div class="article-meta">
								<span>公開 <FormattedDate date={pubDate} /></span>
								{updatedDate && <span>更新 <FormattedDate date={updatedDate} /></span>}
								<span>読了 約{readingMinutes}分</span>
							</div>
						</div>
						{heroImage && (
							<div class="cover-image">
								<Image src={heroImage} alt="" width={900} height={600} loading="eager" fetchpriority="high" />
							</div>
						)}
					</div>
				</header>

				<div class="article-share article-share-top">
					<ShareButtons title={title} label="この記事を共有" />
				</div>

				<div class="article-shell">
					<aside class="article-aside">
						{articleHeadings.length > 0 && (
							<details class="article-toc" open>
								<summary>この記事の内容</summary>
								<nav aria-label="この記事の内容">
									<ol>
										{articleHeadings.map((heading) => <li><a href={`#${heading.slug}`}>{heading.text}</a></li>)}
									</ol>
								</nav>
								<div class="article-caution">
									<p>情報の確認</p>
									<span>掲載時点の情報です。料金、制度、サービス仕様は、必ず公式情報も確認してください。</span>
								</div>
							</details>
						)}
						<div class="article-aside-desktop">
							<section class="aside-section" aria-labelledby="aside-genres-heading">
								<h2 id="aside-genres-heading">ジャンルから探す</h2>
								<BlogGenreNav compact />
							</section>
							{recommendedPosts.length > 0 && (
								<section class="aside-section" aria-labelledby="aside-next-heading">
									<h2 id="aside-next-heading">次に読む</h2>
									<div class="aside-articles">
										{recommendedPosts.slice(0, 2).map((post) => (
											<a href={`/blog/${post.id}/`}>
												{post.data.heroImage && <Image src={post.data.heroImage} alt="" width={160} height={106} loading="lazy" />}
												<span>{post.data.title}</span>
											</a>
										))}
									</div>
								</section>
							)}
							<section class="aside-section" aria-labelledby="aside-apps-heading">
								<h2 id="aside-apps-heading">作ったWebアプリ</h2>
								<WebApps compact />
							</section>
						</div>
					</aside>
					<div class="prose">
						<slot />
					</div>
				</div>

				<div class="article-share article-share-bottom">
					<ShareButtons title={title} label="この記事を共有" />
				</div>

				{recommendedPosts.length > 0 && (
					<section class="article-related shell" aria-labelledby="related-heading">
						<div class="related-heading">
							<h2 id="related-heading">おすすめの記事</h2>
							<p>同じジャンルの記事を優先して、次に読みやすい記事を選びました。</p>
						</div>
						<div class="related-stage">
							{recommendedPosts[0] && <ArticleCard post={recommendedPosts[0]} featured stacked />}
							<div class="related-side">
								{recommendedPosts.slice(1).map((post) => <ArticleCard post={post} compact />)}
							</div>
						</div>
					</section>
				)}

				<section class="article-genres shell" aria-labelledby="article-genres-heading">
					<div class="related-heading">
						<h2 id="article-genres-heading">ジャンルから記事を探す</h2>
						<p>全{allPosts.length}本の記事を、3つのジャンルから選べます。</p>
					</div>
					<BlogGenreNav counts={genreCounts} />
				</section>

				<section class="after-note narrow">
					<h2>次に見るものを選ぶ</h2>
					<p>玉城個人が使っている道具は「道具箱」へ。会社の仕事として相談したい場合は、T&Lサポートへお進みください。</p>
					<div class="button-row">
						<a class="button" href={TOOLBOX_URL}>道具箱を見る</a>
						<a class="button primary" href={COMPANY_URL} target="_blank" rel="noopener noreferrer">相談内容を確認する</a>
					</div>
				</section>
			</article>
		</main>
		<Footer />
	</body>
</html>

<style>
	.article-hero {
		padding: clamp(3rem, 7vw, 6rem) 0;
		border-bottom: 1px solid var(--line);
	}

	.article-hero-inner {
		display: grid;
		grid-template-columns: minmax(0, 1.15fr) minmax(320px, 0.85fr);
		align-items: center;
		gap: clamp(2.5rem, 6vw, 6rem);
	}

	.back-link {
		display: inline-block;
		margin-bottom: 2.5rem;
		color: var(--muted);
		font-size: 0.78rem;
		font-weight: 750;
		text-decoration: none;
	}

	.back-link::before { content: "← "; }

	.category {
		margin-bottom: 0.8rem;
		color: var(--olive-dark);
		font-size: 0.76rem;
		font-weight: 800;
	}

	.article-copy h1 {
		max-width: 900px;
		margin-bottom: 1.3rem;
		font-size: clamp(2.2rem, 4.7vw, 4.5rem);
	}

	.description {
		max-width: 760px;
		color: var(--ink-soft);
		font-size: 1rem;
	}

	.article-meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1.25rem;
		margin-top: 2rem;
		color: var(--muted);
		font-size: 0.72rem;
	}

	.cover-image {
		overflow: hidden;
		border-radius: var(--radius);
		background: var(--paper-deep);
		box-shadow: var(--shadow);
	}

	.cover-image :global(img) {
		width: 100%;
		aspect-ratio: 3 / 2;
		object-fit: cover;
	}

	.article-shell {
		display: grid;
		grid-template-areas: "content aside";
		grid-template-columns: minmax(0, 760px) minmax(200px, 240px);
		justify-content: center;
		gap: clamp(3rem, 6vw, 6rem);
		width: min(calc(100% - 40px), 1180px);
		margin: 0 auto;
		padding: clamp(4rem, 8vw, 7rem) 0;
	}

	.prose {
		grid-area: content;
		min-width: 0;
	}

	.article-aside {
		grid-area: aside;
		position: sticky;
		top: 6rem;
		align-self: start;
		max-height: calc(100dvh - 8rem);
		overflow-y: auto;
		scrollbar-gutter: stable;
	}

	.article-toc,
	.article-caution {
		padding-top: 1rem;
		border-top: 3px solid var(--coral);
	}

	.article-toc summary {
		cursor: pointer;
		font-size: 0.78rem;
		font-weight: 800;
	}

	.article-toc[open] summary { margin-bottom: 0.8rem; }
	.article-toc summary:focus-visible { outline: 3px solid var(--coral); outline-offset: 4px; }
	.article-aside p { margin-bottom: 0.6rem; font-size: 0.78rem; font-weight: 800; }
	.article-aside ol { display: grid; gap: 0.65rem; margin: 0; padding-left: 1.15rem; }
	.article-aside li { color: var(--muted); font-size: 0.72rem; line-height: 1.55; }
	.article-aside a { text-decoration: none; }
	.article-caution { margin-top: 2rem; border-top-color: var(--line); }
	.article-aside span { display: block; color: var(--muted); font-size: 0.72rem; line-height: 1.7; }

	.article-aside-desktop {
		display: grid;
		gap: 2rem;
		margin-top: 2rem;
	}

	.aside-section {
		padding-top: 1rem;
		border-top: 1px solid var(--line);
	}

	.aside-section h2 {
		margin-bottom: 0.8rem;
		font-size: 0.78rem;
		letter-spacing: 0;
	}

	.aside-articles {
		display: grid;
		gap: 0.75rem;
	}

	.aside-articles a {
		display: grid;
		grid-template-columns: 72px minmax(0, 1fr);
		align-items: center;
		gap: 0.65rem;
		color: var(--ink);
		text-decoration: none;
	}

	.aside-articles img {
		width: 72px;
		aspect-ratio: 3 / 2;
		border-radius: 0.35rem;
		object-fit: cover;
	}

	.aside-articles a > span {
		display: -webkit-box;
		overflow: hidden;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 3;
		color: var(--ink);
		font-size: 0.7rem;
		font-weight: 750;
		line-height: 1.55;
	}

	.aside-articles a:hover > span { color: var(--olive-dark); }

	.article-share {
		display: grid;
		grid-template-columns: minmax(0, 760px) minmax(200px, 240px);
		justify-content: center;
		gap: clamp(3rem, 6vw, 6rem);
		width: min(calc(100% - 40px), 1180px);
		margin-inline: auto;
	}

	.article-share-top { margin-top: clamp(2rem, 5vw, 3.5rem); }
	.article-share-bottom { margin-bottom: clamp(2rem, 5vw, 3.5rem); }

	.article-related,
	.article-genres {
		padding-block: clamp(4rem, 8vw, 6.5rem);
		border-top: 1px solid var(--line);
	}

	.article-genres {
		padding-top: 0;
		border-top: 0;
	}

	.related-heading {
		max-width: 680px;
		margin-bottom: clamp(1.6rem, 4vw, 2.5rem);
	}

	.related-heading h2 {
		margin-bottom: 0.65rem;
		font-size: clamp(2rem, 4vw, 3.25rem);
	}

	.related-heading p {
		margin: 0;
		color: var(--muted);
		font-size: 0.9rem;
	}

	.related-stage {
		display: grid;
		grid-template-columns: minmax(0, 1.28fr) minmax(330px, 0.72fr);
		align-items: start;
		gap: clamp(1rem, 2.5vw, 2rem);
	}

	.related-side {
		display: grid;
		gap: 1rem;
	}

	.after-note {
		margin-bottom: clamp(4rem, 8vw, 7rem);
		padding: clamp(2rem, 5vw, 4rem);
		border-radius: var(--radius);
		background: var(--paper-deep);
	}

	.after-note h2 { font-size: clamp(1.8rem, 4vw, 3rem); }
	.after-note > p { max-width: 620px; color: var(--ink-soft); }

	@media (max-width: 1080px) {
		.article-hero-inner { grid-template-columns: 1fr; }
		.article-aside-desktop { display: none; }
		.article-shell {
			grid-template-areas:
				"aside"
				"content";
			grid-template-columns: 1fr;
			width: min(calc(100% - 28px), 760px);
			gap: 2.5rem;
		}
		.article-share {
			grid-template-columns: 1fr;
			width: min(calc(100% - 28px), 760px);
		}
		.article-aside {
			position: static;
			max-height: none;
			overflow: visible;
		}
		.related-stage { grid-template-columns: 1fr; }
		.related-side { grid-template-columns: repeat(2, minmax(0, 1fr)); }
	}

	@media (max-width: 700px) {
		.article-related,
		.article-genres { padding-block: 3.5rem; }
		.article-genres { padding-top: 0; }
		.related-side { grid-template-columns: 1fr; }
	}
</style>
