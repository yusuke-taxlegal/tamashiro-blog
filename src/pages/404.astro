---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
---

<!doctype html>
<html lang="ja">
	<head><BaseHead title="ページが見つかりません｜玉城祐輔" description="お探しのページは見つかりませんでした。" /></head>
	<body>
		<Header />
		<main id="main-content" class="not-found shell">
			<div class="not-found-copy">
				<p class="code">404</p>
				<h1>ページが、<br />見つかりません。</h1>
				<p>URLが変わったか、ページが移動した可能性があります。次の入口からお探しください。</p>
				<a class="button primary" href="/">ホームへ戻る</a>
			</div>
			<nav class="route-list" aria-label="主なページ">
				<a href="/blog/"><strong>記事を読む</strong><span>AI、仕事の道具、経営の現場</span></a>
				<a href="/toolbox/"><strong>道具箱を見る</strong><span>実際に使っている仕事と暮らしの道具</span></a>
				<a href="/about/"><strong>玉城について</strong><span>これまでの経験と、今取り組んでいること</span></a>
			</nav>
		</main>
		<Footer />
	</body>
</html>

<style>
	.not-found { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(320px, 0.85fr); align-items: end; gap: clamp(3rem, 8vw, 8rem); padding-block: clamp(5rem, 12vw, 10rem); }
	.code { margin: 0; color: var(--coral); font-size: 0.8rem; font-weight: 800; letter-spacing: 0.15em; }
	.not-found h1 { font-size: clamp(3rem, 6vw, 4.8rem); }
	.not-found-copy > p:not(.code) { max-width: 620px; color: var(--muted); }
	.route-list { border-top: 4px solid var(--ink); }
	.route-list a { display: grid; gap: 0.25rem; padding: 1.25rem 0; border-bottom: 1px solid var(--line); text-decoration: none; }
	.route-list strong { font-size: 1rem; }
	.route-list span { color: var(--muted); font-size: 0.75rem; }

	@media (max-width: 760px) {
		.not-found { grid-template-columns: 1fr; align-items: start; }
		.not-found h1 { font-size: clamp(2.55rem, 12vw, 3.4rem); }
	}
</style>
