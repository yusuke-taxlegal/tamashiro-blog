---
import { Image } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import profileImage from '../assets/people/tamashiro-yusuke-profile-black-2048.jpg';

const tools = [
	{
		id: 'hidock-p1',
		group: 'work',
		category: '会議・相談の記録',
		channel: 'メーカー紹介',
		title: 'HiDock P1',
		statement: '目の前の相手との会話に、集中する。',
		lead: '録音、文字起こし、要約まで。会議後に長い録音を聞き直す時間を減らすために使っているAIレコーダーです。',
		details: [
			['使う場面', '商工会の相談窓口、巡回相談、オンライン会議、セミナー。'],
			['良かった点', '報告書や議事録の下書きを早く作り、会話中はメモより相手に集中できます。'],
			['購入前の注意', '録音の同意と、AIが作った要約を人が確認する運用が必要です。'],
		],
		url: 'https://jp.hidock.com/pages/referral-program?ref=uzxdtbsg',
		image: 'https://jp.hidock.com/cdn/shop/files/HiDock_P1_Space_Gray_Front_Image.jpg?v=1779855196&width=1200',
		imageAlt: 'HiDock P1 AIボイスレコーダー スペースグレーの正面',
		button: '公式サイトで10%OFF',
		note: '紹介リンクです。購入者はHiDock全製品10%OFFになります。',
		tone: 'coral',
		featured: true,
	},
	{
		id: 'switchbot-lock',
		group: 'home',
		category: '玄関・スマートホーム',
		channel: 'Amazon',
		title: 'SwitchBot スマートロック Pro＋指紋認証パッド',
		statement: '鍵を出す動作と、閉め忘れを減らす。',
		lead: '家族それぞれに合う解錠方法を選びやすい、後付け型のスマートロックです。',
		details: [
			['使う場面', '毎日の玄関。指紋、暗証番号、交通系ICカードなどから解錠方法を選べます。'],
			['良かった点', '鍵を探す手間が減り、オートロックで閉め忘れも減らせます。'],
			['購入前の注意', 'ドアとサムターンの形状、取り付け位置のスペースを確認してください。'],
		],
		url: 'https://amzn.to/4hszTQF',
		image: 'https://m.media-amazon.com/images/I/61lQHV7vkFL._AC_SL1500_.jpg',
		imageAlt: 'SwitchBot スマートロック Proと指紋認証パッド',
		button: 'Amazonで商品を見る',
		note: '価格や在庫はAmazonの商品ページでご確認ください。',
		tone: 'olive',
	},
	{
		id: 'sparkling-water',
		group: 'daily',
		category: '暮らし・飲み物',
		channel: 'Amazon',
		title: '富士山の強炭酸水 ラベルレス 500ml×24本',
		statement: '重いケースを、店から運ばなくていい。',
		lead: '約2カ月に1回購入している、わが家の定番です。機能よりも、箱で家まで届くことが助かっています。',
		details: [
			['使う場面', '日々の飲み物として、ケースで買い置きしています。'],
			['良かった点', '重い炭酸水を自分で運ぶ負担と、ラベルをはがす手間を減らせます。'],
			['購入前の注意', '容量、本数、価格、配送条件は購入時に確認してください。'],
		],
		url: 'https://www.amazon.co.jp/dp/B09LCRNQT4?tag=tamashirotool-22',
		image: 'https://m.media-amazon.com/images/I/61bGltUy7IL._AC_SL1000_.jpg',
		imageAlt: 'アイリスオーヤマ 富士山の強炭酸水 ラベルレス 500ml 24本',
		button: 'Amazonで商品を見る',
		note: '容量、本数、価格、配送条件はAmazonの商品ページでご確認ください。',
		tone: 'paper',
	},
	{
		id: 'soy-milk',
		group: 'daily',
		category: '暮らし・飲み物',
		channel: 'Amazon',
		title: 'マルサン 調製豆乳 カロリー45%オフ 1L×6本',
		statement: '家にある安心を、まとめて買っておく。',
		lead: '2〜3カ月に1回購入しています。未開封のまま買い置きしやすく、飲みたいときに家にあるのが助かります。',
		details: [
			['使う場面', '健康を意識して飲み物を選びたいときの日常の選択肢です。'],
			['良かった点', '6本まとめて届き、未開封なら常温で保管できます。'],
			['購入前の注意', '開封後は冷蔵し、商品表示に従って早めに飲み切ります。'],
		],
		url: 'https://amzn.to/4bDXsSX',
		image: 'https://m.media-amazon.com/images/I/71ic+ExuwhL._AC_SL1400_.jpg',
		imageAlt: 'マルサン 調製豆乳 カロリー45%オフ 1L 6本',
		button: 'Amazonで商品を見る',
		note: '賞味期限、保存方法、内容量、原材料、価格は商品ページと届いた商品の表示をご確認ください。',
		tone: 'paper',
	},
	{
		id: 'toy-cleaner',
		group: 'daily',
		category: '家族・ごっこ遊び',
		channel: 'Amazon',
		title: 'アガツマ(AGATSUMA) アンパンマン スティックスイスイそうじき',
		statement: '掃除が、親子で同じことを楽しむ時間になる。',
		lead: '3歳の娘へのプレゼントとして購入しました。私が掃除機をかける横で、娘もアンパンマンのそうじきを持って一緒に掃除しています。',
		details: [
			['使う場面', '3歳の娘へのプレゼント。大人のまねをしながら遊んでいます。'],
			['良かった点', 'アンパンマンと一緒に遊びながら、自然に家事へ参加できます。'],
			['購入前の注意', 'メーカー対象年齢は3歳以上。電池不要で、使わないときは3つのパーツに分けて収納できます。'],
		],
		url: 'https://amzn.to/4gs6Qf5',
		image: 'https://m.media-amazon.com/images/I/71k5iP-aBdL._AC_SL1500_.jpg',
		imageAlt: 'アガツマ(AGATSUMA) アンパンマン スティックスイスイそうじき',
		button: 'Amazonで商品を見る',
		note: '対象年齢、セット内容、価格、在庫はAmazonの商品ページでご確認ください。',
		tone: 'coral',
	},
	{
		id: 'dyson-v8',
		group: 'home',
		category: '掃除・家電',
		channel: 'Amazon',
		title: 'Dyson V8 Slim Fluffy Extra',
		statement: '最新モデルでなくても、日々の掃除には十分。',
		lead: '新しい機種を追いかけるより、自分の使い方に必要な仕事をきちんとしてくれることを重視しています。',
		details: [
			['使う場面', '家の普段の掃除。娘がトイクリーナーを持って並ぶ時間にも使います。'],
			['良かった点', '取り回しやすく、日常の掃除に必要な仕事を十分にこなしてくれます。'],
			['購入前の注意', '型番によって付属品や販売条件が異なるため、セット内容を確認してください。'],
		],
		url: 'https://amzn.to/3U9FO3n',
		image: 'https://m.media-amazon.com/images/I/61pmiYdSkEL._AC_SL1500_.jpg',
		imageAlt: 'Dyson V8 Slim Fluffy Extra コードレス掃除機',
		button: 'Amazonで商品を見る',
		note: '型番、付属品、保証、価格、在庫はAmazonの商品ページでご確認ください。',
		tone: 'ink',
	},
	{
		id: 'dyson-stand',
		group: 'home',
		category: '掃除・収納',
		channel: 'Amazon',
		title: '八番屋 ダイソン対応スタンド',
		statement: '壁に穴を開けずに、置き場所をつくる。',
		lead: 'ダイソンの掃除機を置くために使っています。壁を傷つけたくない人には、本体と一緒に用意したいスタンドです。',
		details: [
			['使う場面', '壁へ収納用ブラケットを固定せず、掃除機の定位置をつくっています。'],
			['良かった点', '賃貸住宅や、壁へ穴を開けたくない部屋でも設置しやすいです。'],
			['購入前の注意', '手元のダイソンの型番が対応機種に含まれているか確認してください。'],
		],
		url: 'https://amzn.to/4xtkTXp',
		image: 'https://m.media-amazon.com/images/I/41llampoXkL._AC_SL1500_.jpg',
		imageAlt: '八番屋 ダイソン対応スタンド',
		button: 'Amazonで商品を見る',
		note: '対応機種、寸法、組み立て方法、設置条件、価格、在庫をご確認ください。',
		tone: 'olive',
	},
	{
		id: 'dishwasher',
		group: 'home',
		category: 'キッチン・家事',
		channel: 'Amazon',
		title: 'AVAKYO タンク式食器洗い乾燥機 AV-01',
		statement: '水道工事なしで、食器洗いを任せる場所をつくる。',
		lead: 'タンクへ給水して使える食洗機です。水道の分岐工事が難しい場所でも設置を考えやすく、毎日の洗い物を任せられます。',
		details: [
			['使う場面', '毎日の食器洗い。電源、給水、排水を確保できる場所へ置いています。'],
			['良かった点', '水道工事をせずに導入でき、手洗いに使う時間を減らせます。'],
			['購入前の注意', '本体寸法、電源、給水方法、排水ホースを安全に固定できる場所が必要です。'],
		],
		url: 'https://amzn.to/4qijmBm',
		image: 'https://m.media-amazon.com/images/I/51hQDbCYBOL._AC_SL1500_.jpg',
		imageAlt: 'AVAKYO タンク式食器洗い乾燥機 AV-01 ホワイト',
		button: 'Amazonで商品を見る',
		note: '設置寸法、給排水方法、電源条件、容量、対応食器、洗剤、価格、在庫をご確認ください。',
		tone: 'paper',
	},
	{
		id: 'dryer',
		group: 'home',
		category: '洗濯・家事',
		channel: 'Amazon',
		title: '日立 電気衣類乾燥機 DE-N50HV',
		statement: '子育て世代の洗濯には、必須級。',
		lead: '洗濯した衣類をそのまま乾燥まで進められることが助かっています。干す作業と、天気を待つ時間を減らせます。',
		details: [
			['使う場面', '子どもがいて洗濯物が多い日の、毎日の乾燥。メーカー仕様の乾燥容量は5kgです。'],
			['良かった点', '洗濯後の家事をひとつ減らし、子どもと過ごす時間やほかの家事に時間を使えます。'],
			['購入前の注意', '本体寸法、搬入経路、設置台、周囲の空間、電源条件を確認してください。'],
		],
		url: 'https://www.amazon.co.jp/dp/B0BJPMQN8P?tag=tamashirotool-22',
		image: 'https://m.media-amazon.com/images/I/51Itmsso+sL._AC_SL1000_.jpg',
		imageAlt: '日立 電気衣類乾燥機 DE-N50HV ピュアホワイト',
		button: 'Amazonで商品を見る',
		note: '乾燥容量、設置条件、別売品、搬入、電源、使用できる衣類、価格、在庫をご確認ください。',
		tone: 'coral',
		featured: true,
	},
];

const toolCollections = [
	{
		id: 'work-tools',
		label: '仕事',
		title: '会話と記録に集中する。',
		intro: '相談や会議のあとに残る作業を減らし、目の前の相手へ意識を戻す道具です。',
		items: tools.filter((tool) => tool.group === 'work'),
	},
	{
		id: 'home-tools',
		label: '家事',
		title: '家の動作を、ひとつずつ減らす。',
		intro: '鍵、掃除、食器、洗濯。毎日くり返す動作を、無理なく任せられる道具です。',
		items: tools.filter((tool) => tool.group === 'home'),
	},
	{
		id: 'daily-tools',
		label: '日々の定番',
		title: '買い足す理由が、はっきりしている。',
		intro: '運ぶ手間、家にない不安、親子で過ごす時間。小さな負担を減らす定番です。',
		items: tools.filter((tool) => tool.group === 'daily'),
	},
];

const heroTools = tools.filter((tool) => ['hidock-p1', 'dryer'].includes(tool.id));
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead
			title="玉城祐輔の道具箱｜実際に使っている仕事と暮らしの道具"
			description="玉城祐輔が仕事と暮らしで実際に使っている9つの道具を、使う場面、良かった点、購入前の注意まで紹介します。"
		/>
	</head>
	<body class="toolbox-page">
		<Header />
		<main id="main-content">
			<section class="toolbox-hero shell">
				<div class="hero-copy">
					<p class="eyebrow">玉城祐輔の道具箱</p>
					<h1>使っているから、<br /><strong>すすめられる。</strong></h1>
					<p class="hero-lead">仕事と暮らしの負担を減らした9つを、注意点まで紹介します。</p>
					<div class="button-row">
						<a class="button primary" href="#tools">道具を見る</a>
						<a class="button" href="#policy">選び方</a>
					</div>
				</div>
				<div class="hero-visual" aria-label="玉城祐輔と愛用している道具">
					<figure class="hero-portrait">
						<Image src={profileImage} alt="黒い背景の前に立つ玉城祐輔" widths={[480, 720, 960]} sizes="(max-width: 760px) 100vw, 32vw" loading="eager" />
					</figure>
					{heroTools.map((tool) => (
						<a class="hero-product" href={`#${tool.id}`} aria-label={`${tool.title}の紹介へ移動`}>
							<img src={tool.image} alt={tool.imageAlt} loading="eager" decoding="async" referrerpolicy="no-referrer" />
						</a>
					))}
				</div>
			</section>

			<aside class="disclosure" aria-label="広告に関する表示">
				<div class="shell disclosure-inner">
					<strong>紹介リンクについて</strong>
					<p>このページには紹介リンク、アフィリエイトリンクが含まれます。Amazonのアソシエイトとして、玉城祐輔は適格販売により収入を得ています。道具箱の収益は玉城祐輔個人に帰属し、T&amp;Lサポート株式会社の法人サービスとは区別しています。</p>
				</div>
			</aside>

			<section class="tools shell" id="tools" aria-labelledby="tools-title">
				<header class="tools-heading">
					<h2 id="tools-title">今、すすめたい9つ</h2>
					<p>報酬の高さではなく、日々の小さな負担を減らせるかで選んでいます。</p>
				</header>

				<nav class="collection-nav" aria-label="道具の種類">
					{toolCollections.map((collection) => (
						<a href={`#${collection.id}`}>
							<span>{collection.label}</span>
							<strong>{collection.title}</strong>
							<small>{collection.items.length}点</small>
						</a>
					))}
				</nav>

				{toolCollections.map((collection) => (
					<section id={collection.id} class="tool-collection" aria-labelledby={`${collection.id}-title`}>
						<header class="collection-heading">
							<p>{collection.label}</p>
							<h3 id={`${collection.id}-title`}>{collection.title}</h3>
							<span>{collection.intro}</span>
						</header>
						<div class="tool-grid">
							{collection.items.map((tool) => (
								<article id={tool.id} class:list={['tool-card', tool.tone, { featured: tool.featured, wide: tool.id === 'toy-cleaner' }]}>
									<a class="tool-image" href={tool.url} target="_blank" rel="sponsored noopener noreferrer" aria-label={`${tool.title}の商品ページを開く`}>
										<img src={tool.image} alt={tool.imageAlt} loading="lazy" decoding="async" referrerpolicy="no-referrer" />
									</a>
									<div class="tool-copy">
										<div class="tool-meta"><span>{tool.category}</span><span>{tool.channel}</span></div>
										<h4>{tool.title}</h4>
										<p class="tool-statement">{tool.statement}</p>
										<p class="tool-lead">{tool.lead}</p>
										<a class="product-link" href={tool.url} target="_blank" rel="sponsored noopener noreferrer">{tool.button}<span aria-hidden="true">↗</span></a>
										<p class="affiliate-note">広告・アフィリエイトリンクです。{tool.note}</p>
										<details class="tool-notes">
											<summary>使い方と注意点</summary>
											<dl>
												{tool.details.map(([label, value]) => (
													<div><dt>{label}</dt><dd>{value}</dd></div>
												))}
											</dl>
										</details>
									</div>
								</article>
							))}
						</div>
					</section>
				))}
			</section>

			<section class="policy shell" id="policy" aria-labelledby="policy-title">
				<div class="policy-intro">
					<h2 id="policy-title">買わない判断にも、<br />役立つ紹介を。</h2>
					<p>おすすめだけを並べるのではなく、使う場面と、購入前に確認したいことを一緒に残します。</p>
				</div>
				<div class="policy-grid">
					<article><h3>実際に使っている</h3><p>仕事や暮らしの中で使い、何が変わったかを説明できるものだけを掲載します。</p></article>
					<article><h3>注意点も書く</h3><p>便利な点だけでなく、合わない人や購入前に確認すべき条件も紹介します。</p></article>
					<article><h3>情報を固定しない</h3><p>価格や在庫は変わります。最新の条件は必ずリンク先で確認してください。</p></article>
				</div>
			</section>

			<section class="closing shell">
				<p>道具を増やすためではなく、<br />目の前の人と仕事に集中するために選びます。</p>
				<div>
					<strong>玉城祐輔</strong>
					<a href="/affiliate-disclosure/">広告・紹介について</a>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.toolbox-hero {
		display: grid;
		grid-template-columns: minmax(0, 1.05fr) minmax(340px, 0.75fr);
		align-items: center;
		gap: clamp(3rem, 8vw, 8rem);
		padding-block: clamp(4rem, 9vw, 8rem);
	}

	.hero-copy h1 {
		max-width: 800px;
		margin-bottom: 1.6rem;
		font-size: clamp(3rem, 7vw, 6.8rem);
		line-height: 1.05;
	}

	.hero-copy h1 strong {
		display: inline-block;
		font-weight: 750;
	}

	.hero-lead {
		max-width: 620px;
		margin-bottom: 2rem;
		color: var(--ink-soft);
		font-size: clamp(1rem, 1.7vw, 1.2rem);
	}

	.hero-portrait {
		margin: 0;
		transform: rotate(1.5deg);
	}

	.hero-portrait :global(img) {
		width: 100%;
		aspect-ratio: 1;
		border-radius: var(--radius);
		box-shadow: var(--shadow);
		object-fit: cover;
	}

	.hero-portrait figcaption {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		padding: 1rem 0.25rem 0;
		color: var(--muted);
		font-size: 0.72rem;
	}

	.hero-portrait figcaption strong { color: var(--ink); }

	.disclosure {
		border-block: 1px solid var(--line);
		background: var(--ink);
		color: var(--paper);
	}

	.disclosure-inner {
		display: grid;
		grid-template-columns: 220px minmax(0, 760px);
		gap: 2rem;
		padding-block: 1.5rem;
	}

	.disclosure strong { color: var(--coral); font-size: 0.8rem; }
	.disclosure p { margin: 0; color: rgba(255, 253, 248, 0.76); font-size: 0.78rem; line-height: 1.8; }

	.tools { padding-block: clamp(5rem, 10vw, 9rem); }

	.tools-heading {
		display: grid;
		grid-template-columns: 1fr minmax(280px, 0.55fr);
		align-items: end;
		gap: 3rem;
		margin-bottom: clamp(3rem, 6vw, 5rem);
	}

	.tools-heading h2,
	.policy-intro h2 {
		margin: 0;
		font-size: clamp(2.4rem, 5.5vw, 5rem);
	}

	.tools-heading > p,
	.policy-intro > p:last-child { margin: 0; color: var(--muted); }

	.tool-index {
