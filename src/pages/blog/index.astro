---
import { getCollection } from 'astro:content';
import ArticleCard from '../../components/ArticleCard.astro';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead
			title="読む｜玉城祐輔"
			description="沖縄の小さな会社の現場から、AI、仕事の道具、経営の工夫について書いた記事です。"
		/>
	</head>
	<body>
		<Header />
		<main id="main-content">
			<header class="page-intro shell">
				<p class="eyebrow">FIELD NOTES / 読む</p>
				<h1>試して、転んで、<br />わかったこと。</h1>
				<p>AIの使い方から、日々の仕事の道具、経営の現場まで。一般論ではなく、玉城が実際に触ったことを中心に残しています。</p>
			</header>

			<section class="blog-content shell" aria-labelledby="article-list-title">
				<div class="filter-note">
					<h2 id="article-list-title">すべての記事</h2>
					<div aria-label="記事のテーマ">
						<span>AIの使い方</span>
						<span>仕事の道具</span>
						<span>経営の現場</span>
					</div>
				</div>
				<div class="article-list">
					{posts.map((post, index) => <ArticleCard post={post} index={index} />)}
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.blog-content {
		display: grid;
		grid-template-columns: 210px minmax(0, 1fr);
		gap: clamp(2rem, 6vw, 6rem);
	}

	.filter-note {
		position: sticky;
		top: 2rem;
		align-self: start;
		padding-top: 2rem;
		border-top: 4px solid var(--ink);
	}

	.filter-note h2 {
		font-size: 1.15rem;
	}

	.filter-note div {
		display: flex;
		align-items: flex-start;
		flex-direction: column;
		gap: 0.55rem;
		color: var(--muted);
		font-size: 0.78rem;
	}

	@media (max-width: 800px) {
		.blog-content {
			grid-template-columns: 1fr;
		}

		.filter-note {
			position: static;
		}

		.filter-note div {
			align-items: center;
			flex-direction: row;
			flex-wrap: wrap;
		}
	}
</style>
