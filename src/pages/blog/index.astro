---
import { getCollection } from 'astro:content';
import ArticleCard from '../../components/ArticleCard.astro';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const [latestPost, ...otherPosts] = posts;
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead
			title="読む｜玉城祐輔"
			description="沖縄の小さな会社の現場から、AI、仕事の道具、経営の工夫について書いた記事です。"
		/>
	</head>
	<body>
		<Header />
		<main id="main-content">
			<header class="page-intro shell">
				<p class="eyebrow">記事を読む</p>
				<h1>実際に試して、<br />わかったこと。</h1>
				<p>AIの使い方、仕事の道具、経営の現場について、玉城が実際に試したことを中心に書いています。</p>
			</header>

			<section class="blog-content shell" aria-labelledby="latest-article-title">
				<header class="section-heading latest-heading">
					<div>
						<p class="eyebrow">新しい記事</p>
						<h2 id="latest-article-title">まず、ここから。</h2>
					</div>
					<p>{posts.length}本の記事を公開しています。</p>
				</header>
				{latestPost && <ArticleCard post={latestPost} featured />}

				<div class="archive-layout">
					<aside class="theme-note" aria-labelledby="article-list-title">
						<h2 id="article-list-title">これまでの記事</h2>
						<p>現場で試した内容を、3つのテーマで残しています。</p>
						<ul aria-label="記事のテーマ">
							<li>AIの使い方</li>
							<li>仕事の道具</li>
							<li>経営の現場</li>
						</ul>
					</aside>
					<div class="article-list">
						{otherPosts.map((post) => <ArticleCard post={post} />)}
					</div>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.blog-content {
		padding-bottom: clamp(5rem, 10vw, 9rem);
	}

	.latest-heading {
		margin-bottom: 2rem;
	}

	.latest-heading .eyebrow {
		margin-bottom: 0.7rem;
	}

	.latest-heading > p {
		margin: 0;
		color: var(--muted);
		font-size: 0.82rem;
	}

	.archive-layout {
		display: grid;
		grid-template-columns: 210px minmax(0, 1fr);
		gap: clamp(2rem, 6vw, 6rem);
		margin-top: clamp(4rem, 8vw, 7rem);
	}

	.theme-note {
		position: sticky;
		top: 7rem;
		align-self: start;
		padding-top: 2rem;
		border-top: 4px solid var(--ink);
	}

	.theme-note h2 {
		margin-bottom: 0.6rem;
		font-size: 1.15rem;
	}

	.theme-note p,
	.theme-note ul {
		color: var(--muted);
		font-size: 0.78rem;
	}

	.theme-note ul {
		display: grid;
		gap: 0.35rem;
		margin: 1.2rem 0 0;
		padding-left: 1.1rem;
	}

	@media (max-width: 800px) {
		.archive-layout {
			grid-template-columns: 1fr;
		}

		.theme-note {
			position: static;
		}

		.theme-note ul {
			display: flex;
			flex-wrap: wrap;
			gap: 0.4rem 1.5rem;
		}
	}
</style>
