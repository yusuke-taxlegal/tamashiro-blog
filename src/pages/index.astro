---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const recentPosts = posts.slice(0, 5);
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<div class="hero-text">
					<p class="hero-label">DX × 地域ビジネス</p>
					<h1>玉城 祐輔</h1>
					<p class="hero-desc">
						沖縄で中小企業のデジタル活用を支援しています。<br />
						商工会専門家窓口・セミナー講師・月額DX顧問として、<br class="sp-hidden" />
						事業者の「わからない」を「できた」に変える伴走支援を行っています。
					</p>
					<div class="hero-tags">
						<span class="tag">DX支援</span>
						<span class="tag">補助金</span>
						<span class="tag">IT活用</span>
						<span class="tag">商工会</span>
						<span class="tag">沖縄</span>
					</div>
					<div class="hero-actions">
						<a href="/blog" class="btn-primary">ブログを読む</a>
						<a href="/about" class="btn-secondary">プロフィール</a>
					</div>
				</div>
			</section>

			<section class="recent-posts">
				<h2 class="section-title">最新記事</h2>
				<ul class="post-list">
					{
						recentPosts.map((post) => (
							<li>
								<a href={`/blog/${post.id}/`}>
									{post.data.heroImage && (
										<img
											src={post.data.heroImage.src}
											alt={post.data.title}
											class="post-thumbnail"
											loading="lazy"
										/>
									)}
									<div class="post-meta">
										<time class="post-date">
											<FormattedDate date={post.data.pubDate} />
										</time>
										<h3>{post.data.title}</h3>
										{post.data.description && (
											<p class="post-excerpt">{post.data.description}</p>
										)}
									</div>
								</a>
							</li>
						))
					}
				</ul>
				<div class="view-all">
					<a href="/blog" class="btn-secondary">すべての記事を見る →</a>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	/* Hero */
	.hero {
		padding: 4em 0 3em;
	}
	.hero-label {
		font-size: 0.875em;
		font-weight: 700;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--accent);
		margin: 0 0 0.5em;
	}
	.hero h1 {
		font-size: 2.5em;
		margin: 0 0 0.5em;
	}
	.hero-desc {
		font-size: 1.05em;
		color: rgb(var(--gray-dark));
		margin: 0 0 1.5em;
		line-height: 1.8;
	}
	.hero-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5em;
		margin-bottom: 2em;
	}
	.tag {
		display: inline-block;
		padding: 0.25em 0.75em;
		background: rgb(var(--gray-light));
		border-radius: 999px;
		font-size: 0.8em;
		color: rgb(var(--gray-dark));
	}
	.hero-actions {
		display: flex;
		gap: 1em;
		flex-wrap: wrap;
	}
	.btn-primary {
		display: inline-block;
		padding: 0.7em 1.8em;
		background: var(--accent);
		color: white;
		border-radius: 6px;
		text-decoration: none;
		font-weight: 700;
		font-size: 0.95em;
		transition: background 0.2s;
	}
	.btn-primary:hover {
		background: var(--accent-dark);
		color: white;
	}
	.btn-secondary {
		display: inline-block;
		padding: 0.7em 1.8em;
		border: 2px solid rgb(var(--gray-light));
		color: rgb(var(--gray-dark));
		border-radius: 6px;
		text-decoration: none;
		font-weight: 600;
		font-size: 0.95em;
		transition: border-color 0.2s;
	}
	.btn-secondary:hover {
		border-color: var(--accent);
		color: var(--accent);
	}

	/* Recent posts */
	.recent-posts {
		padding: 2em 0 3em;
		border-top: 1px solid rgb(var(--gray-light));
	}
	.section-title {
		font-size: 1.3em;
		margin: 0 0 1.5em;
	}
	.post-list {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 0;
	}
	.post-list li a {
		display: flex;
		gap: 1.25em;
		padding: 1.25em 0;
		border-bottom: 1px solid rgb(var(--gray-light));
		text-decoration: none;
		color: inherit;
		align-items: flex-start;
	}
	.post-list li a:hover h3 {
		color: var(--accent);
	}
	.post-thumbnail {
		width: 100px;
		height: 70px;
		object-fit: cover;
		border-radius: 6px;
		flex-shrink: 0;
	}
	.post-meta {
		flex: 1;
	}
	.post-date {
		font-size: 0.8em;
		color: rgb(var(--gray));
		display: block;
		margin-bottom: 0.3em;
	}
	.post-meta h3 {
		font-size: 1em;
		margin: 0 0 0.3em;
		transition: color 0.15s;
	}
	.post-excerpt {
		font-size: 0.875em;
		color: rgb(var(--gray));
		margin: 0;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
	.view-all {
		margin-top: 2em;
		text-align: center;
	}

	@media (max-width: 720px) {
		.hero h1 {
			font-size: 2em;
		}
		.post-thumbnail {
			width: 80px;
			height: 56px;
		}
	}
</style>
