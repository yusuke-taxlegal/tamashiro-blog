---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import profilePhoto from '../assets/people/tamashiro-yusuke-profile-black-2048.jpg';
import ArticleCard from '../components/ArticleCard.astro';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { COMPANY_URL, SITE_DESCRIPTION, SITE_TITLE, TOOLBOX_URL } from '../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main id="main-content">
			<section class="hero shell">
				<div class="hero-copy">
					<p class="eyebrow">AI × MANAGEMENT × OKINAWA</p>
					<h1>むずかしいことを、<br /><em>現場で使える形</em>に。</h1>
					<p class="lead">
						元・商工会経営指導員の玉城祐輔です。沖縄の小さな会社で、AIとデジタルを実際に試しながら、仕事を少しずつ楽にする方法を届けます。
					</p>
					<div class="button-row">
						<a class="button primary" href="/blog">記事を読む</a>
						<a class="button" href="/about">玉城について</a>
					</div>
					<div class="hero-note">
						<span>元・商工会経営指導員 11年</span>
						<span>500社以上の支援</span>
						<span>沖縄・4児のパパ</span>
					</div>
				</div>
				<div class="hero-portrait">
					<div class="portrait-frame">
						<Image
							src={profilePhoto}
							alt="黒い背景の前に立つ玉城祐輔"
							width={820}
							height={820}
							loading="eager"
							fetchpriority="high"
						/>
						<span class="portrait-label">YUSUKE<br />TAMASHIRO</span>
					</div>
					<p class="hand-note">まず10点だけ、<br />仕事を楽に。</p>
				</div>
			</section>

			<section class="manifesto">
				<div class="shell manifesto-grid">
					<p class="manifesto-number">01</p>
					<h2>AIは魔法ではなく、<br />仕事を楽にする<strong>大工道具。</strong></h2>
					<div>
						<p>全部を自動化しようとしなくて大丈夫です。自分で触って、うまくいかなかったところも含めて、現場で役立ったことだけを残します。</p>
						<a href="/about">このサイトについて →</a>
					</div>
				</div>
			</section>

			<section class="latest shell">
				<div class="section-heading">
					<div>
						<p class="eyebrow">FIELD NOTES</p>
						<h2>現場からの記録</h2>
					</div>
					<a href="/blog">すべての記事を見る →</a>
				</div>
				<div class="article-list">
					{posts.slice(0, 3).map((post, index) => <ArticleCard post={post} index={index} />)}
				</div>
			</section>

			<section class="paths shell">
				<div class="section-heading">
					<div>
						<p class="eyebrow">NEXT STEP</p>
						<h2>次にできること</h2>
					</div>
				</div>
				<div class="path-grid">
					<a class="path-card personal" href={TOOLBOX_URL}>
						<span>PERSONAL / 道具箱</span>
						<h3>実際に使っている<br />道具をのぞく</h3>
						<p>仕事と暮らしで使っているガジェットやサービスを、個人の目線で紹介しています。</p>
						<strong>玉城祐輔の道具箱へ →</strong>
					</a>
					<a class="path-card company" href={COMPANY_URL} target="_blank" rel="noopener noreferrer">
						<span>BUSINESS / 法人相談</span>
						<h3>会社の困りごとを<br />一緒に整理する</h3>
						<p>AI活用、業務整理、経営伴走のご相談は、T&Lサポート株式会社で承っています。</p>
						<strong>T&Lサポート株式会社へ ↗</strong>
					</a>
				</div>
				<p class="separation-note">※「道具箱」は玉城個人の紹介活動、「法人相談」はT&Lサポート株式会社のサービスです。</p>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.hero {
		display: grid;
		grid-template-columns: minmax(0, 1.05fr) minmax(340px, 0.8fr);
		align-items: center;
		gap: clamp(3rem, 7vw, 7rem);
		min-height: min(820px, calc(100vh - 86px));
		padding-block: clamp(3.5rem, 7vw, 7rem);
	}

	.hero h1 {
		max-width: 820px;
		margin-bottom: 1.5rem;
		font-size: clamp(3rem, 7.1vw, 7rem);
		line-height: 1.08;
	}

	.hero h1 em {
		position: relative;
		font-family: var(--font-serif);
		font-style: normal;
		font-weight: 650;
	}

	.hero h1 em::after {
		position: absolute;
		right: 0;
		bottom: -0.08em;
		left: 0;
		height: 0.12em;
		background: var(--coral);
		content: "";
	}

	.lead {
		max-width: 650px;
		margin-bottom: 2rem;
		color: var(--ink-soft);
		font-size: clamp(1rem, 1.6vw, 1.18rem);
	}

	.hero-note {
		display: flex;
		flex-wrap: wrap;
		gap: 0.45rem 1rem;
		margin-top: 2.3rem;
		padding-top: 1rem;
		border-top: 1px solid var(--line);
		color: var(--muted);
		font-size: 0.72rem;
		font-weight: 700;
	}

	.hero-note span + span::before {
		margin-right: 1rem;
		color: var(--coral);
		content: "●";
		font-size: 0.5rem;
	}

	.hero-portrait {
		position: relative;
	}

	.portrait-frame {
		position: relative;
		overflow: hidden;
		border-radius: 48% 48% 1rem 1rem;
		background: var(--ink);
		box-shadow: var(--shadow);
	}

	.portrait-frame :global(img) {
		width: 100%;
		aspect-ratio: 1;
		object-fit: cover;
	}

	.portrait-label {
		position: absolute;
		right: 1.25rem;
		bottom: 1.25rem;
		color: rgba(255, 255, 255, 0.7);
		font-size: 0.62rem;
		font-weight: 800;
		letter-spacing: 0.16em;
		line-height: 1.3;
		text-align: right;
	}

	.hand-note {
		position: absolute;
		right: -1.7rem;
		bottom: -2.2rem;
		width: 8rem;
		margin: 0;
		padding: 1.2rem 1rem;
		transform: rotate(-4deg);
		background: var(--coral);
		color: var(--white);
		font-family: var(--font-serif);
		font-size: 0.93rem;
		font-weight: 700;
		line-height: 1.55;
		box-shadow: 0 14px 30px rgba(77, 45, 29, 0.18);
	}

	.manifesto {
		padding: clamp(4rem, 8vw, 7rem) 0;
		background: var(--olive);
		color: var(--white);
	}

	.manifesto-grid {
		display: grid;
		grid-template-columns: 70px minmax(0, 1.6fr) minmax(260px, 0.7fr);
		align-items: start;
		gap: clamp(2rem, 5vw, 5rem);
	}

	.manifesto-number {
		margin: 0;
		color: rgba(255, 255, 255, 0.55);
		font-size: 0.72rem;
		font-weight: 800;
		letter-spacing: 0.12em;
	}

	.manifesto h2 {
		margin: 0;
		color: var(--white);
		font-family: var(--font-serif);
		font-size: clamp(2.2rem, 5vw, 4.7rem);
		font-weight: 500;
		line-height: 1.45;
	}

	.manifesto h2 strong {
		color: #ffd1bf;
	}

	.manifesto-grid > div p {
		color: rgba(255, 255, 255, 0.82);
		font-size: 0.96rem;
	}

	.manifesto-grid > div a {
		color: var(--white);
		font-size: 0.84rem;
		font-weight: 800;
	}

	.latest,
	.paths {
		padding-top: clamp(5rem, 10vw, 9rem);
	}

	.path-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 1rem;
	}

	.path-card {
		display: flex;
		min-height: 430px;
		padding: clamp(2rem, 5vw, 3.5rem);
		flex-direction: column;
		border-radius: var(--radius);
		text-decoration: none;
		transition: transform 180ms ease;
	}

	.path-card:hover {
		transform: translateY(-5px);
		color: inherit;
	}

	.path-card > span {
		font-size: 0.68rem;
		font-weight: 800;
		letter-spacing: 0.13em;
	}

	.path-card h3 {
		margin: auto 0 1rem;
		font-size: clamp(1.8rem, 4vw, 3.25rem);
	}

	.path-card p {
		max-width: 520px;
		font-size: 0.9rem;
	}

	.path-card strong {
		font-size: 0.82rem;
	}

	.personal {
		background: var(--paper-deep);
	}

	.company {
		background: var(--ink);
		color: var(--paper);
	}

	.company p {
		color: #c9c8bb;
	}

	.separation-note {
		margin: 1rem 0 0;
		color: var(--muted);
		font-size: 0.75rem;
	}

	@media (max-width: 920px) {
		.hero {
			grid-template-columns: 1fr;
		}

		.hero-portrait {
			width: min(82vw, 520px);
			margin: 0 auto;
		}

		.manifesto-grid {
			grid-template-columns: 45px 1fr;
		}

		.manifesto-grid > div {
			grid-column: 2;
		}
	}

	@media (max-width: 700px) {
		.hero {
			padding-top: 3rem;
		}

		.hero h1 {
			font-size: clamp(2.65rem, 14vw, 4.7rem);
		}

		.hero-note span + span::before {
			display: none;
		}

		.hand-note {
			right: -0.5rem;
		}

		.path-grid {
			grid-template-columns: 1fr;
		}

		.path-card {
			min-height: 360px;
		}
	}
</style>
