---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';
import profilePhoto from '../assets/people/tamashiro-yusuke-profile-black-2048.jpg';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import ArticleRow from '../components/ArticleRow.astro';
import BlogGenreNav from '../components/BlogGenreNav.astro';
import PopularArticles from '../components/PopularArticles.astro';
import { COMPANY_URL, TOOLBOX_URL } from '../consts';
import { sortPostsByRecency } from '../lib/blogNavigation';
import '../styles/article-rows.css';
import '../styles/home.css';

const allPosts = sortPostsByRecency(await getCollection('blog'));
// 新しい記事は6本（スマホは1列、PCは2列でそろう数）
const posts = allPosts.slice(0, 6);
const tools = [
 { name: 'HiDock P1 AIボイスレコーダー', image: '/images/home-tools/hidock-p1.jpg', description: '相談や会議を録音し、文字起こしと要約まで。', href: '/blog/hidock-p1-ai-recorder/' },
 { name: 'シャープ ヘルシオ ホットクック KN-HW24G-R', image: '/images/home-tools/hotcook.jpg', description: '夕飯の仕込みを、朝のうちに。', href: '/blog/healsio-hotcook-kn-hw24g/' },
 { name: 'SwitchBot ロック Pro＋指紋認証パッド', image: '/images/home-tools/switchbot.jpg', description: '鍵を出す手間を減らす。', href: '/blog/switchbot-lock-pro/' },
];
const apps = [
 { name: 'SeminarFlow', image: '/images/apps/seminarflow-ogp.png', description: '申込受付から名簿・連絡・共有まで。', href: 'https://seminar-flow.com/' },
 { name: 'JIZOKA', image: '/images/apps/jizoka-ogp.png', description: '持続化補助金の計画書づくりをサポート。', href: 'https://jizoka.app/' },
 { name: 'JC規則財審アシスタント', image: '/images/apps/kisoku-zaishin-ogp.png', description: '議案の提出前の見落としを、まとめて点検。', href: 'https://kisoku-zaishin.com/' },
 { name: 'ポイレシ', image: '/images/apps/poireshi-ogp.png', description: '領収書はLINEにポイッと送るだけ。', href: 'https://poireshi.com/' },
];
const title = '玉城祐輔｜仕事と暮らしの、役立つ実践ノート。';
const description = 'AI、道具、経営の工夫を、玉城祐輔の経験から。沖縄を拠点に、仕事と暮らしで実際に試したことを発信しています。';
---
<!doctype html>
<html lang="ja">
 <head><BaseHead title={title} description={description} /></head>
 <body class="journal-home">
  <Header showName />
  <main id="main-content">
   <section class="journal-hero" aria-labelledby="hero-heading">
    <div class="shell hero-grid">
     <div class="hero-copy">
      <h1 id="hero-heading">仕事と暮らしの、<br /><span>役立つ実践ノート。</span></h1>
      <p><span>AI、道具、経営の工夫を、</span><span>玉城祐輔の経験から。</span></p>
     </div>
     <Image class="hero-photo" src={profilePhoto} alt="黒い背景の前で笑顔を見せる玉城祐輔" widths={[320, 480, 800]} sizes="(max-width: 720px) 84px, 220px" width={800} height={800} loading="eager" fetchpriority="high" quality={90} />
    </div>
   </section>

   <section class="list-section shell" aria-labelledby="recent-heading">
    <div class="list-heading"><h2 id="recent-heading">新しい記事</h2></div>
    <ul class="article-rows">
     {posts.map(post => <ArticleRow post={post} />)}
    </ul>
    <a class="list-more" href="/blog/">すべての記事を見る <Icon name="ri:arrow-right-line" aria-hidden="true" /></a>
   </section>

   <PopularArticles posts={allPosts} />

   <section class="list-section shell" aria-labelledby="tools-heading">
    <div class="list-heading"><h2 id="tools-heading">使ってよかった道具</h2></div>
    <ul class="article-rows contain three">
     {tools.map(tool => <li><a href={tool.href}><span class="row-thumb"><img src={tool.image} alt="" width="600" height="450" loading="lazy" decoding="async" /></span><span class="row-body"><h3 class="row-title">{tool.name}</h3><span class="row-note">{tool.description}</span></span></a></li>)}
    </ul>
    <a class="list-more" href={TOOLBOX_URL}>道具箱をすべて見る <Icon name="ri:arrow-right-line" aria-hidden="true" /></a>
    <p class="journal-disclosure">紹介先にはアフィリエイトリンクを含みます。<a href="/affiliate-disclosure/">広告・紹介について</a></p>
   </section>

   <section class="list-section shell" aria-label="ジャンルで探す">
    <details class="genre-fold">
     <summary>ジャンルで探す</summary>
     <BlogGenreNav />
    </details>
   </section>

   <section class="journal-tinted list-section home-apps" aria-labelledby="apps-heading">
    <div class="shell">
     <div class="list-heading"><h2 id="apps-heading">自分で作ったアプリ</h2><p class="list-sub">現場の手間を減らすために、作っています。</p></div>
     <ul class="article-rows">
      {apps.map(app => <li><a href={app.href} target="_blank" rel="noopener noreferrer" aria-label={`${app.name}を開く（新しいタブ）`}><span class="row-thumb app-thumb"><img src={app.image} alt="" width="1200" height="630" loading="lazy" decoding="async" /></span><span class="row-body"><h3 class="row-title">{app.name} <Icon name="ri:arrow-right-up-line" aria-hidden="true" /></h3><span class="row-note">{app.description}</span></span></a></li>)}
     </ul>
    </div>
   </section>

   <section class="journal-about shell" aria-labelledby="about-heading">
    <div class="journal-heading"><h2 id="about-heading">玉城祐輔について</h2></div>
    <div><p>沖縄を拠点に、AI活用や業務の仕組みづくりに取り組んでいます。<br />元・商工会経営指導員。仕事と暮らしで試したことを発信しています。</p><div class="about-links"><a class="text-link" href="/about/">玉城について詳しく見る <Icon name="ri:arrow-right-line" aria-hidden="true" /></a><a class="text-link" href={COMPANY_URL} target="_blank" rel="noopener noreferrer">仕事のご相談は T&Lサポートへ <Icon name="ri:arrow-right-up-line" aria-hidden="true" /></a></div></div>
   </section>
  </main>
  <footer class="journal-footer">
   <div class="shell footer-top">
    <a class="footer-brand" href="/" aria-label="玉城祐輔 ホーム"><img src="/images/tamashiro-yusuke-logo.svg?v=3" alt="" width="48" height="48" /><span>玉城祐輔</span></a>
    <nav aria-label="フッターナビゲーション"><a href="/blog/">記事を読む</a><a href={TOOLBOX_URL}>道具箱</a><a href="/about/">玉城について</a></nav>
    <div class="footer-social"><a href="https://www.facebook.com/tamashiro.taxlegal" target="_blank" rel="noopener noreferrer"><Icon name="ri:facebook-circle-fill" aria-hidden="true" />Facebook</a><a href="https://www.instagram.com/tamashiro_taxlegal/" target="_blank" rel="noopener noreferrer"><Icon name="ri:instagram-line" aria-hidden="true" />Instagram</a></div>
   </div>
   <div class="shell footer-bottom"><small>© {new Date().getFullYear()} Yusuke Tamashiro</small><div><a href="/privacy/">プライバシー</a><a href="/affiliate-disclosure/">広告・紹介について</a></div></div>
  </footer>
 </body>
</html>
