---
import { Image } from 'astro:assets';
import currentWorkIllustration from '../assets/about/tamashiro-current-work.webp';
import profilePhoto from '../assets/people/tamashiro-yusuke-profile-black-2048.jpg';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { COMPANY_URL } from '../consts';
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead
			title="玉城について｜玉城祐輔"
			description="元・商工会経営指導員11年。沖縄で小さな会社のデジタルとお金の相談に伴走する玉城祐輔のプロフィールです。"
		/>
	</head>
	<body class="about-page">
		<Header />
		<main id="main-content">
			<header class="about-hero shell">
				<div class="about-copy">
					<p class="about-kicker">沖縄の現場で、相談に向き合う</p>
					<h1 id="about-title"><span>相談に向き合った、</span><br /><strong>11年。</strong></h1>
					<p class="lead">元・商工会経営指導員として11年、500社以上の相談に向き合ってきました。いまはT&Lサポート株式会社の代表として、自社でもAIと財務の立て直しを実践しています。</p>
					<p class="about-note">成功談だけでなく、試して失敗したことや遠回りしたことも共有します。自分で確かめたことを、現場で使える形にして届けます。</p>
				</div>
				<figure class="about-photo">
					<Image
						src={profilePhoto}
						alt="黒い背景の前に立つ玉城祐輔"
						widths={[480, 720, 900]}
						sizes="(max-width: 760px) 72vw, 36vw"
						loading="eager"
						fetchpriority="high"
					/>
				</figure>
			</header>

			<section class="profile-band">
				<div class="shell facts">
					<div><strong>11年</strong><span>商工会経営指導員</span></div>
					<div><strong>500社以上</strong><span>これまでの支援</span></div>
					<div><strong>4人</strong><span>子どもたちの父</span></div>
					<div><strong>沖縄</strong><span>活動の拠点</span></div>
				</div>
			</section>

			<section class="work shell" id="work" aria-labelledby="work-title">
				<header class="work-heading">
					<h2 id="work-title">今、取り組んでいること</h2>
					<p>制度や技術を、使える形にする。</p>
				</header>
				<div class="work-layout">
					<figure class="work-photo">
						<Image
							src={currentWorkIllustration}
							alt="AIの活用方法をパソコンで試し、チェックリストと研修資料にまとめる玉城祐輔のイラスト"
							widths={[640, 920, 1280]}
							sizes="(max-width: 800px) 100vw, 45vw"
							loading="lazy"
						/>
					</figure>
					<div class="work-list">
						<article>
							<h3>小さな会社のAI活用支援</h3>
							<p>専任のIT担当者を置けない小さな会社に、難しい説明ではなく「明日から使える形」でAIやデジタルを届けます。</p>
						</article>
						<article>
							<h3>経営支援者向けの研修・道具</h3>
							<p>商工会の中で11年働いた経験を生かし、経営指導員や支援機関が相談対応で使える研修と道具をつくります。</p>
						</article>
						<article>
							<h3>自社で試して確かめる</h3>
							<p>自分の会社でも、AIと財務を使った改善を実践中です。自分で試していないことを、体験談のようには語りません。</p>
						</article>
					</div>
				</div>
			</section>

			<section class="pathways shell" aria-labelledby="pathways-title">
				<header>
					<h2 id="pathways-title">個人の発信と、<br />法人の相談。</h2>
					<p>情報を読む入口と、仕事として相談する入口を混ぜずに案内します。</p>
				</header>
				<div class="pathway-list">
					<article>
						<p class="pathway-label">玉城祐輔 個人</p>
						<h3>試したことを読む</h3>
						<p>このサイトでは、AI、仕事の道具、経営の現場で実際に試したことを残しています。道具箱の紹介活動も個人の発信です。</p>
						<div class="text-links"><a href="/blog/">記事を読む</a><a href="/toolbox/">道具箱を見る</a></div>
					</article>
					<article class="company-pathway">
						<p class="pathway-label">T&amp;Lサポート株式会社</p>
						<h3>仕事として相談する</h3>
						<p>法人としてのAI活用、業務整理、経営伴走は、T&amp;Lサポート株式会社で承ります。</p>
					</article>
				</div>
			</section>

			<section class="contact shell" aria-labelledby="contact-title">
				<div class="contact-copy">
					<h2 id="contact-title">AI活用と経営の相談は、<br />T&amp;Lサポートへ。</h2>
					<p>法人としてのAI活用・業務整理・経営伴走のご相談は、T&Lサポート株式会社で承ります。</p>
				</div>
				<a class="button contact-button" href={COMPANY_URL} target="_blank" rel="noopener noreferrer">相談内容を確認する</a>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	:global(body.about-page) {
		--site-bg: #f4f0e7;
		--site-surface: #fffdf8;
		--site-surface-subtle: #e8e1d2;
		--site-text: #171915;
		--site-text-soft: #4f5348;
		--site-muted: #62655b;
		--site-line: rgba(23, 25, 21, 0.16);
		--site-accent: #d95f3b;
		--site-link-hover: #424b32;
		--site-contact-bg: #66724b;
		--site-contact-text: #fffdf8;
		--site-contact-muted: #e4e8d9;
		--header-bg: color-mix(in srgb, var(--site-bg) 92%, transparent);
		--footer-bg: #171915;
		--footer-text: #f4f0e7;
		--footer-muted: #aaa999;
		--coral: var(--site-accent);
		--ink: var(--site-text);
		--ink-soft: var(--site-text-soft);
		--paper: var(--site-bg);
		--paper-deep: var(--site-surface-subtle);
		--white: var(--site-surface);
		--line: var(--site-line);
		--muted: var(--site-muted);
		background: var(--site-bg);
		color: var(--site-text);
	}

	.about-hero {
		display: grid;
		grid-template-columns: minmax(0, 1.14fr) minmax(320px, 0.72fr);
		align-items: center;
		gap: clamp(3rem, 8vw, 7rem);
		min-height: calc(100dvh - 72px);
		padding-block: clamp(3rem, 6vw, 5.5rem);
	}

	.about-kicker {
		margin-bottom: 1rem;
		color: var(--site-link-hover);
		font-size: 0.78rem;
		font-weight: 800;
		letter-spacing: 0.06em;
	}

	.about-copy h1 {
		max-width: 760px;
		margin-bottom: 1.6rem;
		color: var(--site-text);
		font-size: clamp(3rem, 4.5vw, 4.5rem);
		font-weight: 780;
		line-height: 1.04;
	}

	.about-copy h1 > span {
		display: inline-block;
		white-space: nowrap;
	}

	.about-copy h1 strong {
		display: inline-block;
		color: var(--site-text);
		font-weight: inherit;
		text-decoration: underline;
		text-decoration-color: var(--site-accent);
		text-decoration-thickness: 0.09em;
		text-underline-offset: 0.11em;
		white-space: nowrap;
	}

	.about-copy .lead {
		max-width: 650px;
		margin-bottom: 1.2rem;
		color: var(--site-text-soft);
		font-size: clamp(1rem, 1.45vw, 1.14rem);
		font-weight: 650;
		line-height: 1.9;
	}

	.about-note {
		max-width: 620px;
		margin: 0;
		color: var(--site-muted);
		font-size: 0.9rem;
	}

	.about-photo {
		margin: 0;
		overflow: hidden;
		border-radius: var(--radius);
		background: #11130f;
		box-shadow: 0 26px 70px color-mix(in srgb, var(--site-text) 14%, transparent);
	}

	.about-photo :global(img) {
		width: 100%;
		aspect-ratio: 4 / 4.55;
		object-fit: cover;
		object-position: 50% 35%;
	}

	.profile-band {
		border-block: 1px solid var(--site-line);
		background: color-mix(in srgb, var(--site-surface-subtle) 66%, var(--site-bg));
	}

	.facts {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
	}

	.facts div {
		display: grid;
		gap: 0.15rem;
		padding: 1.4rem clamp(1rem, 2.5vw, 2rem);
		border-right: 1px solid var(--site-line);
	}

	.facts div:last-child { border-right: 0; }
	.facts strong { color: var(--site-text); font-size: clamp(1.5rem, 2.6vw, 2.2rem); }
	.facts span { color: var(--site-muted); font-size: 0.72rem; }

	.work {
		padding-block: clamp(5.5rem, 10vw, 9rem);
	}

	.work-heading {
		max-width: 820px;
		margin-bottom: clamp(2.5rem, 6vw, 4.5rem);
	}

	.work-heading h2 {
		margin-bottom: 0.8rem;
		color: var(--site-text);
		font-size: clamp(2.2rem, 4vw, 3.6rem);
	}

	.work-heading p {
		margin: 0;
		color: var(--site-text-soft);
		font-family: var(--font-serif);
		font-size: clamp(1.65rem, 3vw, 2.75rem);
		font-weight: 600;
		line-height: 1.45;
	}

	.work-layout {
		display: grid;
		grid-template-columns: minmax(0, 1.08fr) minmax(340px, 0.92fr);
		align-items: start;
		gap: clamp(2.5rem, 6vw, 6rem);
	}

	.work-photo {
		margin: 0;
		overflow: hidden;
		border-radius: var(--radius);
		background: var(--site-surface-subtle);
	}

	.work-photo :global(img) {
		width: 100%;
		aspect-ratio: 4 / 3;
		object-fit: cover;
	}

	.work-list article {
		padding: 1.75rem 0;
		border-top: 1px solid var(--site-line);
	}

	.work-list article:first-child { padding-top: 0; border-top: 0; }
	.work-list h3 { margin-bottom: 0.55rem; color: var(--site-text); font-size: 1.45rem; }
	.work-list p { margin: 0; color: var(--site-muted); font-size: 0.9rem; }

	.pathways {
		padding-block: clamp(4.5rem, 9vw, 8rem);
		border-top: 1px solid var(--site-line);
	}

	.pathways > header {
		max-width: 780px;
		margin-bottom: clamp(2.5rem, 5vw, 4rem);
	}

	.pathways h2 {
		margin-bottom: 1rem;
		color: var(--site-text);
		font-size: clamp(2.2rem, 4.5vw, 4rem);
	}

	.pathways > header p {
		max-width: 55ch;
		margin: 0;
		color: var(--site-text-soft);
	}

	.pathway-list {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1rem;
	}

	.pathway-list article {
		display: flex;
		min-width: 0;
		min-height: 300px;
		padding: clamp(1.8rem, 4vw, 3rem);
		flex-direction: column;
		border: 1px solid var(--site-line);
		border-radius: var(--radius);
		background: var(--site-surface);
	}

	.pathway-list .company-pathway { background: var(--site-surface-subtle); }

	.pathway-label {
		margin-bottom: auto;
		padding-bottom: 2.5rem;
		color: var(--site-accent);
		font-size: 0.72rem;
		font-weight: 800;
	}

	.pathway-list h3 { margin-bottom: 0.8rem; color: var(--site-text); font-size: clamp(1.7rem, 3vw, 2.35rem); }
	.pathway-list article > p:not(.pathway-label) { color: var(--site-muted); font-size: 0.88rem; }
	.text-links { display: flex; flex-wrap: wrap; gap: 0.75rem 1.2rem; margin-top: 1.5rem; }
	.text-links a { color: var(--site-text); font-size: 0.82rem; font-weight: 800; }
	.text-links a:hover { color: var(--site-link-hover); }

	.contact {
		display: grid;
		grid-template-columns: minmax(0, 1.2fr) auto;
		align-items: end;
		gap: clamp(2rem, 6vw, 6rem);
		margin-top: clamp(1rem, 4vw, 3rem);
		padding: clamp(2.5rem, 6vw, 5rem);
		border-radius: var(--radius);
		background: var(--site-contact-bg);
		color: var(--site-contact-text);
	}

	.contact-copy { max-width: 730px; }
	.contact h2 { margin-bottom: 1rem; color: var(--site-contact-text); font-size: clamp(2rem, 4.2vw, 3.8rem); }
	.contact p { margin: 0; color: var(--site-contact-muted); }

	.contact-button {
		justify-self: end;
		border-color: color-mix(in srgb, var(--site-contact-text) 70%, transparent);
		color: var(--site-contact-text);
		white-space: nowrap;
	}

	.contact-button:hover {
		background: var(--site-contact-text);
		color: #171915;
	}

	.contact-button:active {
		transform: translateY(-1px) scale(0.98);
	}

	@media (prefers-color-scheme: dark) {
		:global(body.about-page) {
			--site-bg: #11130f;
			--site-surface: #191d16;
			--site-surface-subtle: #23291d;
			--site-text: #f1eee5;
			--site-text-soft: #c7c9bd;
			--site-muted: #aeb3a3;
			--site-line: rgba(241, 238, 229, 0.18);
			--site-accent: #ef805d;
			--site-link-hover: #b8c897;
			--site-contact-bg: #3f4b31;
			--site-contact-text: #f1eee5;
			--site-contact-muted: #d7dfc4;
			--header-bg: color-mix(in srgb, var(--site-bg) 90%, transparent);
			--footer-bg: #0b0d0a;
			--footer-text: #f1eee5;
			--footer-muted: #aeb3a3;
		}
	}

	@media (max-width: 860px) {
		.about-hero,
		.work-layout { grid-template-columns: 1fr; }

		.about-hero {
			min-height: auto;
			padding-block: 3rem 4.5rem;
		}

		.about-hero > *,
		.work-layout > * { min-width: 0; }
		.about-photo { width: min(72vw, 360px); margin-inline: auto; }
		.work-photo { width: min(100%, 720px); }
	}

	@media (max-width: 700px) {
		.about-copy h1 { font-size: clamp(2.1rem, 9.5vw, 3.4rem); }
		.facts { grid-template-columns: repeat(2, minmax(0, 1fr)); }
		.facts div:nth-child(2) { border-right: 0; }
		.facts div:nth-child(-n+2) { border-bottom: 1px solid var(--site-line); }
		.pathway-list { grid-template-columns: 1fr; }
		.pathway-list article { min-height: 260px; }
		.contact { grid-template-columns: 1fr; align-items: start; }
		.contact-button { justify-self: start; }
	}

	@media (max-width: 390px) {
		.about-copy h1 { font-size: 8.7vw; }
		.about-photo { width: min(78vw, 330px); }
	}
</style>
