---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead
			title="プロフィール | 玉城祐輔"
			description="玉城祐輔のプロフィール。T&Lサポート株式会社代表。沖縄で中小企業のDX支援・経営伴走を行っています。"
		/>
	</head>
	<body>
		<Header />
		<main>
			<article class="about">
				<h1>プロフィール</h1>

				<div class="profile-block">
					<div class="profile-text">
						<h2 class="name">玉城 祐輔（たましろ ゆうすけ）</h2>
						<p class="title">T&Lサポート株式会社 代表取締役</p>
						<p>
							沖縄県を拠点に、中小企業・個人事業主のデジタル活用支援と経営伴走を行っています。
							「難しいITを、使えるものに」をモットーに、現場に寄り添った支援を心がけています。
						</p>
					</div>
				</div>

				<h2>主な活動</h2>
				<ul class="activity-list">
					<li>
						<strong>商工会専門家窓口</strong>
						<span>北谷町・恩納村・北中城村の商工会にて、IT活用・DX推進の専門家として月次巡回支援を実施</span>
					</li>
					<li>
						<strong>月額デジタル顧問</strong>
						<span>中小企業・士業事務所のDX推進を月額契約で伴走。業務効率化・ツール導入・AI活用を支援</span>
					</li>
					<li>
						<strong>セミナー講師</strong>
						<span>Google・SNS・AI活用など、事業者向けのIT活用セミナーを多数開催</span>
					</li>
					<li>
						<strong>補助金・助成金支援</strong>
						<span>持続化補助金・IT導入補助金など、デジタル投資に関わる補助金申請を支援</span>
					</li>
				</ul>

				<h2>得意分野</h2>
				<div class="skill-tags">
					<span class="tag">Google Workspace</span>
					<span class="tag">SNS運用</span>
					<span class="tag">AI活用（ChatGPT / Claude）</span>
					<span class="tag">業務自動化</span>
					<span class="tag">ウェブサイト制作</span>
					<span class="tag">持続化補助金</span>
					<span class="tag">IT導入補助金</span>
					<span class="tag">LINE公式アカウント</span>
				</div>

				<h2>連絡先・SNS</h2>
				<ul class="contact-list">
					<li>
						<strong>Email:</strong>
						<a href="mailto:tamashiro@taxlegal.jp">tamashiro@taxlegal.jp</a>
					</li>
					<li>
						<strong>Facebook:</strong>
						<a href="https://www.facebook.com/yusuke.tamashiro" target="_blank" rel="noopener noreferrer">
							facebook.com/yusuke.tamashiro
						</a>
					</li>
					<li>
						<strong>Instagram:</strong>
						<a href="https://www.instagram.com/tamashiro_yusuke_tl/" target="_blank" rel="noopener noreferrer">
							@tamashiro_yusuke_tl
						</a>
					</li>
				</ul>
			</article>
		</main>
		<Footer />
	</body>
</html>

<style>
	.about {
		max-width: 720px;
		margin: 0 auto;
		padding: 3em 1em;
	}
	.about h1 {
		font-size: 2em;
		margin-bottom: 1.5em;
	}
	.about h2 {
		font-size: 1.25em;
		margin: 2em 0 0.75em;
		padding-bottom: 0.4em;
		border-bottom: 2px solid rgb(var(--gray-light));
	}
	.profile-block {
		display: flex;
		gap: 2em;
		margin-bottom: 0.5em;
		align-items: flex-start;
	}
	.profile-text {
		flex: 1;
	}
	.name {
		font-size: 1.5em;
		margin: 0 0 0.25em;
		border: none;
		padding: 0;
	}
	.title {
		color: var(--accent);
		font-weight: 700;
		margin: 0 0 1em;
		font-size: 0.95em;
	}
	.activity-list {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 1em;
	}
	.activity-list li {
		display: flex;
		flex-direction: column;
		gap: 0.2em;
		padding: 0.75em 1em;
		background: rgb(var(--gray-light), 40%);
		border-radius: 8px;
	}
	.activity-list li strong {
		font-size: 0.95em;
	}
	.activity-list li span {
		font-size: 0.875em;
		color: rgb(var(--gray-dark));
		line-height: 1.6;
	}
	.skill-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5em;
	}
	.tag {
		display: inline-block;
		padding: 0.3em 0.8em;
		background: rgb(var(--gray-light));
		border-radius: 999px;
		font-size: 0.85em;
		color: rgb(var(--gray-dark));
	}
	.contact-list {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 0.6em;
		font-size: 0.95em;
	}
	.contact-list li {
		display: flex;
		gap: 0.5em;
		flex-wrap: wrap;
		align-items: baseline;
	}
</style>
