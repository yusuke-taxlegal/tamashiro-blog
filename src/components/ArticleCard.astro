---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import FormattedDate from './FormattedDate.astro';

interface Props {
	post: CollectionEntry<'blog'>;
	featured?: boolean;
	compact?: boolean;
	stacked?: boolean;
}

const { post, featured = false, compact = false, stacked = false } = Astro.props;
const readingMinutes = Math.max(1, Math.ceil((post.body?.length || 0) / 600));
---

<article class:list={['article-card', { featured, compact, stacked }]}>
	<a href={`/blog/${post.id}/`} aria-label={`${post.data.title}を読む`}>
		<div class="card-visual">
			{post.data.heroImage && (
				<Image
					src={post.data.heroImage}
					alt=""
					width={720}
					height={480}
					loading="lazy"
				/>
			)}
		</div>
		<div class="card-body">
			<div class="card-meta">
				<span>{post.data.category}</span>
				<span><FormattedDate date={post.data.pubDate} />　約{readingMinutes}分</span>
			</div>
			<h3>{post.data.title}</h3>
			<p>{post.data.description}</p>
			<span class="read-more">この記事を読む <span aria-hidden="true">→</span></span>
		</div>
	</a>
</article>

<style>
	.article-card {
		border-top: 1px solid var(--site-line, var(--line));
	}

	.article-card.featured {
		overflow: hidden;
		border: 0;
		border-radius: var(--radius);
		background: var(--site-surface, var(--white));
		box-shadow: var(--shadow);
	}

	.article-card.compact {
		overflow: hidden;
		border: 1px solid var(--site-line, var(--line));
		border-radius: var(--radius);
		background: var(--site-surface, var(--white));
	}

	.article-card > a {
		display: grid;
		grid-template-columns: minmax(220px, 0.86fr) minmax(0, 1.65fr);
		align-items: center;
		gap: clamp(1.5rem, 4vw, 3.5rem);
		padding: clamp(1.5rem, 3vw, 2.3rem) 0;
		text-decoration: none;
	}

	.article-card.featured > a {
		grid-template-columns: minmax(0, 1.12fr) minmax(320px, 0.88fr);
		gap: 0;
		padding: 0;
	}

	.article-card.featured .card-visual {
		align-self: stretch;
		border-radius: 0;
	}

	.article-card.featured .card-visual :global(img) {
		height: 100%;
		min-height: 430px;
		aspect-ratio: auto;
	}

	.article-card.featured .card-body {
		padding: clamp(2rem, 4vw, 3.5rem);
	}

	.article-card.featured .card-body h3 {
		font-size: clamp(1.8rem, 3vw, 2.55rem);
	}

	.article-card.featured.stacked > a {
		grid-template-columns: 1fr;
	}

	.article-card.featured.stacked .card-visual :global(img) {
		height: auto;
		min-height: 0;
		aspect-ratio: 16 / 9;
	}

	.article-card.featured.stacked .card-body {
		padding: clamp(1.75rem, 4vw, 2.75rem);
	}

	.article-card.compact > a {
		grid-template-columns: minmax(120px, 0.7fr) minmax(0, 1fr);
		gap: 1rem;
		padding: 0;
	}

	.article-card.compact .card-visual {
		align-self: stretch;
		border-radius: 0;
	}

	.article-card.compact .card-visual :global(img) {
		height: 100%;
		min-height: 190px;
		aspect-ratio: auto;
	}

	.article-card.compact .card-body {
		padding: 1.25rem 1.25rem 1.25rem 0;
	}

	.article-card.compact .card-body h3 {
		font-size: clamp(1.05rem, 1.7vw, 1.35rem);
	}

	.article-card.compact .card-body p {
		display: -webkit-box;
		overflow: hidden;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 2;
		font-size: 0.82rem;
	}

	.card-visual {
		overflow: hidden;
		border-radius: var(--radius);
		background: var(--site-surface-subtle, var(--paper-deep));
	}

	.card-visual :global(img) {
		width: 100%;
		aspect-ratio: 3 / 2;
		object-fit: cover;
		transition: transform 280ms ease;
	}

	.card-meta {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 0.5rem 1rem;
		margin-bottom: 0.85rem;
		color: var(--site-muted, var(--muted));
		font-size: 0.72rem;
		font-weight: 750;
	}

	.card-body h3 {
		max-width: 760px;
		margin-bottom: 0.75rem;
		font-size: clamp(1.35rem, 2.7vw, 2.15rem);
	}

	.card-body p {
		max-width: 720px;
		margin-bottom: 1rem;
		color: var(--site-muted, var(--muted));
		font-size: 0.93rem;
	}

	.read-more { font-size: 0.8rem; font-weight: 800; }
	.article-card a:hover .card-visual :global(img) { transform: scale(1.025); }
	.article-card a:hover h3 { color: var(--site-link-hover, var(--olive-dark)); }
	.article-card a:active .card-visual :global(img) { transform: scale(1.01); }

	@media (max-width: 680px) {
		.article-card > a { grid-template-columns: 1fr; }
		.article-card.featured > a { grid-template-columns: 1fr; }
		.article-card.featured .card-visual :global(img) { min-height: 0; aspect-ratio: 3 / 2; }
		.article-card.featured .card-body { padding: 1.5rem; }
		.article-card.compact > a { grid-template-columns: 1fr; }
		.article-card.compact .card-visual :global(img) { min-height: 0; aspect-ratio: 3 / 2; }
		.article-card.compact .card-body { padding: 1.25rem; }
		.card-body p { font-size: 0.9rem; }
	}
</style>
