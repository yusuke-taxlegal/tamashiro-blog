---
import type { CollectionEntry } from 'astro:content';
import FormattedDate from './FormattedDate.astro';

interface Props {
	post: CollectionEntry<'blog'>;
	index?: number;
}

const { post, index = 0 } = Astro.props;
const readingMinutes = Math.max(1, Math.ceil((post.body?.length || 0) / 600));
---

<article class:list={['article-card', `accent-${post.data.accent}`]}>
	<a href={`/blog/${post.id}/`} aria-label={`${post.data.title}を読む`}>
		<div class="card-visual" aria-hidden="true">
			<span class="card-number">{String(index + 1).padStart(2, '0')}</span>
			<span class="visual-line"></span>
			<span class="visual-dot"></span>
		</div>
		<div class="card-body">
			<div class="card-meta">
				<span>{post.data.category}</span>
				<span><FormattedDate date={post.data.pubDate} /> · 約{readingMinutes}分</span>
			</div>
			<h3>{post.data.title}</h3>
			<p>{post.data.description}</p>
			<span class="read-more">続きを読む <span aria-hidden="true">→</span></span>
		</div>
	</a>
</article>

<style>
	.article-card {
		border-top: 1px solid var(--line);
	}

	.article-card > a {
		display: grid;
		grid-template-columns: minmax(170px, 0.75fr) minmax(0, 2fr);
		gap: clamp(1.4rem, 4vw, 3.5rem);
		padding: 2rem 0;
		text-decoration: none;
	}

	.card-visual {
		position: relative;
		min-height: 180px;
		overflow: hidden;
		border-radius: var(--radius);
		background: var(--olive);
		transition: transform 180ms ease;
	}

	.accent-coral .card-visual { background: var(--coral); }
	.accent-ink .card-visual { background: var(--ink); }

	.card-number {
		position: absolute;
		top: 1rem;
		left: 1rem;
		color: rgba(255, 255, 255, 0.86);
		font-size: 0.72rem;
		font-weight: 800;
		letter-spacing: 0.14em;
	}

	.visual-line {
		position: absolute;
		right: -15%;
		bottom: 22%;
		width: 85%;
		height: 1px;
		transform: rotate(-28deg);
		background: rgba(255, 255, 255, 0.6);
	}

	.visual-dot {
		position: absolute;
		right: 18%;
		top: 20%;
		width: 2.7rem;
		height: 2.7rem;
		border-radius: 50%;
		background: var(--paper);
	}

	.card-meta {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 0.5rem 1rem;
		margin-bottom: 0.85rem;
		color: var(--muted);
		font-size: 0.72rem;
		font-weight: 750;
		letter-spacing: 0.05em;
	}

	.card-body h3 {
		max-width: 760px;
		margin-bottom: 0.75rem;
		font-size: clamp(1.35rem, 3vw, 2.25rem);
	}

	.card-body p {
		max-width: 720px;
		margin-bottom: 1rem;
		color: var(--muted);
		font-size: 0.93rem;
	}

	.read-more {
		font-size: 0.8rem;
		font-weight: 800;
	}

	.article-card a:hover .card-visual {
		transform: rotate(-1deg) translateY(-3px);
	}

	.article-card a:hover h3 {
		color: var(--olive-dark);
	}

	@media (max-width: 640px) {
		.article-card > a {
			grid-template-columns: 1fr;
		}

		.card-visual {
			min-height: 120px;
		}
	}
</style>
