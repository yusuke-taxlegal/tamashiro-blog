		imageAlt: '日立 電気衣類乾燥機 DE-N50HV ピュアホワイト',
		button: 'Amazonで商品を見る',
		note: '乾燥容量、設置条件、別売品、搬入、電源、使用できる衣類、価格、在庫をご確認ください。',
		tone: 'coral',
		featured: true,
	},
];


const collectionDefinitions = [
	{
		id: 'work-tools',
		group: 'work',
		title: '仕事の道具',
		intro: '相談や会議の記録、外出先での通信に使っています。仕事の手間を減らし、目の前の相手に集中するための道具です。',
		href: '/toolbox/work/',
		linkLabel: '仕事の道具を詳しく読む',
	},
	{
		id: 'home-tools',
		group: 'home',
		title: '家の道具',
		intro: '鍵、掃除、食器、洗濯、飲み物、子どもとの時間。家事の負担を減らし、家族と過ごす時間をつくるための道具です。',
		href: '/toolbox/home/',
		linkLabel: '家の道具を詳しく読む',
	},
];

/** 一覧は「詳しい版」ではなくカタログ。詳細ページ（work / home）だけ読み物の並びにする */
const isDetail = view !== 'index';

/** おすすめ（featured）を各グループの先頭に寄せる。それ以外は書いた順のまま */
function orderTools(items: Tool[]): Tool[] {
	return [...items].sort((a, b) => Number(Boolean(b.featured)) - Number(Boolean(a.featured)));
}

const countOf = (group: string) => tools.filter((tool) => tool.group === group).length;
const workCount = countOf('work');
const homeCount = countOf('home');

const visibleDefinitions = isDetail
	? collectionDefinitions.filter((collection) => collection.group === view)
	: collectionDefinitions;

const toolCollections = visibleDefinitions.map((collection) => {
	const items = orderTools(tools.filter((tool) => tool.group === collection.group));
	return { ...collection, items, count: items.length };
});

const pageCopy = {
	index: {
		title: '玉城祐輔の道具箱｜仕事と家で実際に使っている道具',
		description: '玉城祐輔が仕事と家で実際に使い続けている道具を一覧にしました。使う場面、良かった点、買う前の注意点まで添えています。',
		eyebrow: '玉城祐輔の道具箱',
		lead: 'いま実際に使い続けているものだけを並べました。気になる道具は「使い方と注意点」を開くと、買う前に確認したいことまで読めます。',
	},
	work: {
		title: '仕事で使っている道具｜玉城祐輔の道具箱',
		description: '相談、会議、外出先で玉城祐輔が実際に使っている仕事の道具を、使い方と注意点まで紹介します。',
		eyebrow: '仕事で使っている道具',
		lead: '相談の記録と外出先の通信。仕事の手間を減らすために使っている道具を、詳しく紹介します。',
	},
	home: {
		title: '家で使っている道具｜玉城祐輔の道具箱',
		description: '家事や子育てで玉城祐輔が実際に使っている家庭用の道具を、使い方と注意点まで紹介します。',
		eyebrow: '家で使っている道具',
		lead: '家事の回数や待つ時間を減らすために、家で使っている道具をまとめました。',
	},
}[view];

---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead
			title={pageCopy.title}
			description={pageCopy.description}
		/>
	</head>
	<body class:list={['journal-page', 'toolbox-page', `toolbox-${view}`, { 'toolbox-detail': isDetail }]}>
		<Header showName />
		<main id="main-content">
			<section class="toolbox-hero shell">
				<div class="hero-copy">
					{isDetail && <a class="back-link" href="/toolbox/">道具箱の入口へ戻る</a>}
					<p class="eyebrow">{pageCopy.eyebrow}</p>
					{view === 'index' && <h1>使ってよかった<strong>道具を、ぜんぶ。</strong></h1>}
					{view === 'work' && <h1>仕事で使う、<strong>{workCount}つの道具。</strong></h1>}
					{view === 'home' && <h1>家事を減らす、<strong>{homeCount}の道具。</strong></h1>}
					<p class="hero-lead">{pageCopy.lead}</p>
				</div>
			</section>

			<div class="toolbox-share toolbox-share-top shell">
				<ShareButtons title={pageCopy.title} label="この道具ページを共有" />
			</div>

			<section class="tools shell" id="tools" aria-label="紹介している道具">
				{toolCollections.map((collection) => (
					<section id={collection.id} class="tool-collection" aria-labelledby={`${collection.id}-title`}>
						<header class="collection-heading">
							<div>
								<h2 id={`${collection.id}-title`}>{collection.title}</h2>
								<p>{collection.intro}</p>
							</div>
							<span class="collection-count">{collection.count}品</span>
						</header>
						<div class="tool-grid">
							{collection.items.map((tool) => (
								<article id={tool.id} class:list={['tool-card', tool.tone, { featured: tool.featured }]}>
									<a class="tool-image" href={tool.url} target="_blank" rel="sponsored noopener noreferrer" aria-label={`${tool.title}の商品ページを開く`}>
										<img src={tool.image} alt={tool.imageAlt} loading="lazy" decoding="async" referrerpolicy="no-referrer" />
										{tool.featured && <span class="tool-badge">おすすめ</span>}
									</a>
									<div class="tool-copy">
										<p class="tool-category">{tool.category}</p>
										<h3>{tool.title}</h3>
										<p class="tool-statement">{tool.statement}</p>
										{isDetail && <p class="tool-lead">{tool.lead}</p>}
										<div class="tool-links">
											{tool.articleHref && (
												<a class="article-link" href={tool.articleHref} aria-label={`${tool.title}の紹介記事を読む`}>
													紹介記事を読む<span aria-hidden="true">→</span>
												</a>
											)}
											<a class="product-link" href={tool.url} target="_blank" rel="sponsored noopener noreferrer">{isDetail ? tool.button : tool.shortButton ?? tool.button}<span aria-hidden="true">↗</span></a>
											{tool.rakutenUrl && <a class="product-link" href={tool.rakutenUrl} target="_blank" rel="sponsored noopener noreferrer">{tool.rakutenButton ?? '楽天市場で商品を見る'}<span aria-hidden="true">↗</span></a>}
											<p class="affiliate-note">広告・アフィリエイトリンクです。</p>
										</div>
										<details class="tool-notes" open={isDetail}>
											<summary>使い方と注意点</summary>
											<div class="tool-notes-body">
												{!isDetail && <p class="tool-lead">{tool.lead}</p>}
												<dl>
													{tool.details.map(([label, value]) => (
														<div><dt>{label}</dt><dd>{value}</dd></div>
													))}
												</dl>
												{tool.officialUrl && <a class="official-link" href={tool.officialUrl} target="_blank" rel="noopener noreferrer">{tool.officialLabel}<span aria-hidden="true">↗</span></a>}
												<p class="tool-caution">{tool.note}</p>
											</div>
										</details>
									</div>
								</article>
							))}
						</div>
						{!isDetail && (
							<a class="collection-action" href={collection.href}>
								<span>{collection.linkLabel}</span>
								<strong>{collection.count}品</strong>
							</a>
						)}
					</section>
				))}
			</section>

			<div class="toolbox-share toolbox-share-bottom shell">
				<ShareButtons title={pageCopy.title} label="この道具ページを共有" />
			</div>

			<section class="closing shell">
				<p>道具を増やすためではなく、目の前の人と仕事に集中するために選びます。</p>
				<div>
					<strong>玉城祐輔</strong>
					<a href="/affiliate-disclosure/">広告・紹介について</a>
				</div>
			</section>

			<aside class="disclosure" aria-label="広告に関する表示">
				<div class="shell disclosure-inner">
					<strong>広告</strong>
					<p>{disclosureNotice}</p>
				</div>
			</aside>
		</main>
		<Footer />
	</body>
</html>
