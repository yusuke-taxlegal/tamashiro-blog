---
import { BLOG_GENRES, type BlogGenreId } from '../lib/blogNavigation';

// ジャンルごとのページ（/blog/ai/ など）への入口。本数は出さない。
interface Props {
	compact?: boolean;
	current?: BlogGenreId;
}

const { compact = false, current } = Astro.props;
---

<nav class:list={['blog-genre-nav', { compact }]} aria-label="記事のジャンル">
	{BLOG_GENRES.map((genre) => (
		<a href={`/blog/${genre.id}/`} aria-current={genre.id === current ? 'page' : undefined}>
			<span class="genre-copy">
				<strong>{genre.label}</strong>
				{!compact && <small>{genre.description}</small>}
			</span>
			<span class="genre-arrow" aria-hidden="true">›</span>
		</a>
	))}
</nav>

<style>
	.blog-genre-nav { display: grid; grid-template-columns: minmax(0, 1fr); }
	.blog-genre-nav a {
		display: flex;
		min-height: 60px;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding: 0.7rem 0.25rem;
		border-bottom: 1px solid var(--site-line, var(--line));
		color: var(--site-text, var(--ink));
		text-decoration: none;
	}
	.blog-genre-nav a:last-child { border-bottom: 0; }
	.blog-genre-nav a:hover strong { color: var(--site-accent, var(--coral)); text-decoration: underline; text-underline-offset: 0.3em; }
	.genre-copy { display: grid; gap: 0.15rem; }
	.genre-copy strong { font-size: 1rem; line-height: 1.5; }
	.genre-copy small { color: var(--site-muted, var(--muted)); font-size: 0.8rem; line-height: 1.6; }
	.genre-arrow { flex: 0 0 auto; color: var(--site-accent, var(--coral)); font-size: 1.5rem; line-height: 1; }

	.blog-genre-nav.compact a { min-height: 44px; padding: 0.4rem 0; }
	.blog-genre-nav.compact .genre-copy strong { font-size: 0.85rem; }
	.blog-genre-nav.compact .genre-arrow { font-size: 1.1rem; }
</style>
