---
import { NEWSLETTER } from '../../lib/newsletter/config';

interface Props {
	variant?: 'card' | 'page';
	heading?: string;
}

const { variant = 'card', heading = '記事の更新をメールで受け取る' } = Astro.props;
const formId = `newsletter-${variant}`;
---

<section class:list={['newsletter-signup', variant === 'card' && 'shell', `is-${variant}`]} data-newsletter aria-labelledby={`${formId}-heading`}>
	<div class="newsletter-copy">
		<p class="eyebrow">{NEWSLETTER.title}</p>
		<h2 id={`${formId}-heading`}>{heading}</h2>
		<p>{NEWSLETTER.promise}お送りします。登録はメールアドレスだけ、配信停止はいつでも1クリックです。</p>
	</div>
	<form class="newsletter-form" data-newsletter-form novalidate>
		<label for={`${formId}-email`}>メールアドレス</label>
		<div class="newsletter-row">
			<input type="email" id={`${formId}-email`} name="email" autocomplete="email" inputmode="email" required placeholder="you@example.com" />
			<button type="submit">登録する</button>
		</div>
		<div class="newsletter-decoy" aria-hidden="true">
			<label for={`${formId}-company`}>会社名（入力しないでください）</label>
			<input type="text" id={`${formId}-company`} name="company" tabindex="-1" autocomplete="off" />
		</div>
		<p class="newsletter-note">
			登録ボタンを押すと確認メールが届きます。メール内のリンクを押すと登録完了です。記事の紹介には広告・アフィリエイトリンクを含みます。<a href="/privacy/#newsletter">情報の取り扱い</a>
		</p>
		<p class="newsletter-status" data-newsletter-status aria-live="polite"></p>
	</form>
</section>

<script>
	document.querySelectorAll<HTMLFormElement>('[data-newsletter-form]').forEach((form) => {
		const input = form.querySelector<HTMLInputElement>('input[name="email"]');
		const decoy = form.querySelector<HTMLInputElement>('input[name="company"]');
		const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
		const status = form.querySelector<HTMLElement>('[data-newsletter-status]');
		if (!input || !button || !status) return;

		const messages: Record<string, string> = {
			invalid_email: 'メールアドレスの形をご確認ください。',
			too_many_requests: '短時間に送信が続きました。1分ほどおいてからお試しください。',
			mail_failed: '確認メールを送れませんでした。時間をおいてもう一度お試しください。',
			unavailable: 'ただいま受け付けできません。時間をおいてもう一度お試しください。',
		};

		const setStatus = (message: string, state: 'ok' | 'error' | '') => {
			status.textContent = message;
			status.dataset.state = state;
		};

		// Enterキーでも送れるようにする（入力欄が複数あるとブラウザ任せでは送信されない場合がある）。
		input.addEventListener('keydown', (event) => {
			if (event.key !== 'Enter') return;
			event.preventDefault();
			form.requestSubmit();
		});

		form.addEventListener('submit', async (event) => {
			event.preventDefault();
			const email = input.value.trim();
			if (!email || !input.checkValidity()) {
				setStatus(messages.invalid_email, 'error');
				input.focus();
				return;
			}
			button.disabled = true;
			setStatus('送信しています。', '');
			try {
				const response = await fetch('/api/newsletter/subscribe', {
					method: 'POST',
					headers: { 'content-type': 'application/json' },
					credentials: 'same-origin',
					body: JSON.stringify({ email, company: decoy?.value || '', source: location.pathname }),
				});
				const payload = await response.json().catch(() => null) as { ok?: boolean; error?: string } | null;
				if (response.ok && payload?.ok) {
					form.reset();
					setStatus('確認メールを送りました。メール内のリンクを押すと登録完了です。届かない場合は迷惑メールフォルダもご確認ください。', 'ok');
				} else {
					setStatus(messages[payload?.error || 'unavailable'] || messages.unavailable, 'error');
				}
			} catch {
				setStatus('通信できませんでした。接続を確認して、もう一度お試しください。', 'error');
			} finally {
				button.disabled = false;
			}
		});
	});
</script>

<style>
	.newsletter-signup {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		align-items: center;
		gap: 1.5rem 2.5rem;
		padding: clamp(1.5rem, 3.5vw, 2.4rem);
		border: 1px solid var(--line);
		border-radius: var(--radius);
		background: var(--paper-deep);
	}

	.newsletter-signup.is-card { margin-top: clamp(2.5rem, 6vw, 4rem); }
	.newsletter-signup.is-page { grid-template-columns: 1fr; background: var(--white); }

	.eyebrow {
		margin: 0 0 0.5rem;
		color: var(--muted);
		font-size: 0.7rem;
		font-weight: 800;
		letter-spacing: 0.12em;
	}

	.newsletter-copy h2 { margin: 0 0 0.5rem; font-size: clamp(1.05rem, 2.2vw, 1.3rem); }
	.newsletter-copy p { margin: 0; color: var(--ink-soft); font-size: 0.85rem; }

	.newsletter-form label {
		display: block;
		margin-bottom: 0.4rem;
		font-size: 0.72rem;
		font-weight: 800;
		letter-spacing: 0.06em;
	}

	.newsletter-row { display: flex; flex-wrap: wrap; gap: 0.6rem; }

	.newsletter-row input {
		flex: 1 1 15rem;
		min-width: 0;
		min-height: 48px;
		padding: 0.7rem 0.9rem;
		border: 1px solid var(--ink);
		border-radius: 0.6rem;
		background: var(--white);
		color: var(--ink);
		font: inherit;
		font-size: 0.95rem;
	}

	.newsletter-row input:focus-visible,
	.newsletter-row button:focus-visible { outline: 3px solid var(--coral); outline-offset: 3px; }

	.newsletter-row button {
		min-height: 48px;
		padding: 0.7rem 1.6rem;
		border: 1px solid var(--ink);
		border-radius: 999px;
		background: var(--ink);
		color: var(--paper);
		font: inherit;
		font-size: 0.85rem;
		font-weight: 800;
		cursor: pointer;
	}

	.newsletter-row button:hover:not(:disabled) { border-color: var(--coral); background: var(--coral); }
	.newsletter-row button:disabled { opacity: 0.58; cursor: not-allowed; }

	.newsletter-decoy { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }

	.newsletter-note { margin: 0.75rem 0 0; color: var(--muted); font-size: 0.72rem; }
	.newsletter-note a { color: inherit; }

	.newsletter-status { margin: 0.6rem 0 0; font-size: 0.78rem; font-weight: 700; }
	.newsletter-status:empty { display: none; }
	.newsletter-status[data-state='ok'] { color: var(--olive-dark); }
	.newsletter-status[data-state='error'] { color: var(--coral); }

	@media (max-width: 760px) {
		.newsletter-signup { grid-template-columns: 1fr; }
	}
</style>
