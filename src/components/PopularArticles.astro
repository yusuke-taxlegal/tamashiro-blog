---
import { getImage } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { getBlogGenreLabel } from '../lib/blogNavigation';
import '../styles/article-rows.css';

interface Props {
	posts: CollectionEntry<'blog'>[];
	/** 「読者の参考になった記事」も出すか（トップだけ出す） */
	showHelpful?: boolean;
}

const { posts, showHelpful = true } = Astro.props;

// ランキングはブラウザ側で組み立てるため、サムネイル・ジャンル名・日付もビルド時に用意して渡す。
// heroImage を持たない記事があるので、画像は任意として扱う。
const articleEntries = await Promise.all(
	posts.map(async (post) => {
		const thumbnail = post.data.heroImage
			? await getImage({ src: post.data.heroImage, width: 320, height: 213, format: 'webp', quality: 80 })
			: null;
		const date = post.data.pubDate;
		return [
			post.id,
			{
				title: post.data.title,
				href: `/blog/${post.id}/`,
				genre: getBlogGenreLabel(post.data.category),
				date: `${date.getUTCFullYear()}.${String(date.getUTCMonth() + 1).padStart(2, '0')}.${String(date.getUTCDate()).padStart(2, '0')}`,
				datetime: date.toISOString(),
				image: thumbnail ? thumbnail.src : null,
			},
		] as const;
	}),
);
const articleMetadata = Object.fromEntries(articleEntries);
---

<section class="popular-articles list-section shell" data-popular-articles data-articles={JSON.stringify(articleMetadata)} hidden aria-labelledby="popular-heading">
	<div data-popular-group="views">
		<div class="list-heading">
			<h2 id="popular-heading">よく読まれている記事</h2>
			<p class="list-sub">昨日までの30日間</p>
		</div>
		<ol class="article-rows ranked three" data-popular-list="views"></ol>
	</div>
	{showHelpful && (
		<div class="popular-helpful" data-popular-group="helpful" hidden>
			<h3 class="list-subheading">読者の参考になった記事</h3>
			<ol class="article-rows ranked three" data-popular-list="helpful"></ol>
		</div>
	)}
</section>

<script>
	const popularSection = document.querySelector('[data-popular-articles]');

	if (popularSection instanceof HTMLElement) {
		type ArticleMeta = { title: string; href: string; genre: string; date: string; datetime: string; image: string | null };
		const knownArticles: Record<string, ArticleMeta> = JSON.parse(popularSection.dataset.articles || '{}');
		const el = <K extends keyof HTMLElementTagNameMap>(tag: K, className?: string, text?: string) => {
			const node = document.createElement(tag);
			if (className) node.className = className;
			if (text) node.textContent = text;
			return node;
		};
		// ArticleRow.astro と同じ形の行を作る
		const fill = (kind: 'views' | 'helpful', entries: { article: string }[] | undefined) => {
			const list = popularSection.querySelector(`[data-popular-list="${kind}"]`);
			const group = popularSection.querySelector<HTMLElement>(`[data-popular-group="${kind}"]`);
			if (!list || !group || !Array.isArray(entries)) return 0;
			let count = 0;
			for (const entry of entries) {
				const article = knownArticles[entry?.article];
				if (!article) continue;
				const link = el('a');
				link.href = article.href;
				const thumb = el('span', 'row-thumb');
				if (article.image) {
					const image = el('img');
					image.src = article.image;
					image.width = 320;
					image.height = 213;
					image.alt = '';
					image.loading = 'lazy';
					image.decoding = 'async';
					thumb.append(image);
				}
				const body = el('span', 'row-body');
				body.append(el('span', 'row-genre', article.genre), el('span', 'row-title', article.title));
				const time = el('time', 'row-date', article.date);
				time.dateTime = article.datetime;
				body.append(time);
				link.append(thumb, body);
				const item = el('li');
				item.append(link);
				list.append(item);
				count += 1;
			}
			group.hidden = count === 0;
			return count;
		};

		fetch('/api/popular', { credentials: 'same-origin' })
			.then((response) => {
				if (!response.ok) throw new Error('Popular request failed');
				return response.json() as Promise<{ popular?: { article: string }[]; helpful?: { article: string }[] }>;
			})
			.then((payload) => {
				const viewCount = fill('views', payload?.popular);
				const helpfulCount = fill('helpful', payload?.helpful);
				if (viewCount || helpfulCount) popularSection.hidden = false;
			})
			.catch(() => {});
	}
</script>
