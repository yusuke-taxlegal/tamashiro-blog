---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import type { CollectionEntry } from 'astro:content';
import FormattedDate from './FormattedDate.astro';

interface Props {
	posts: CollectionEntry<'blog'>[];
	label: string;
}

const { posts, label } = Astro.props;
---

<div class="article-carousel" data-article-carousel>
	<div class="carousel-toolbar">
		<p class="carousel-status" data-carousel-status aria-live="polite">全{posts.length}本</p>
		<div class="carousel-controls" aria-label={`${label}の表示を移動`}>
			<button type="button" data-carousel-previous aria-label="前の記事を見る" disabled>
				<Icon name="ri:arrow-left-line" aria-hidden="true" />
			</button>
			<button type="button" data-carousel-next aria-label="次の記事を見る">
				<Icon name="ri:arrow-right-line" aria-hidden="true" />
			</button>
		</div>
	</div>
	<div
		class="carousel-viewport"
		data-carousel-viewport
		tabindex="0"
		role="region"
		aria-roledescription="カルーセル"
		aria-label={label}
	>
		<ol class="carousel-track">
			{posts.map((post) => (
				<li class="carousel-item" data-carousel-item>
					<a href={`/blog/${post.id}/`}>
						<div class="carousel-image">
							{post.data.heroImage ? (
								<Image
									src={post.data.heroImage}
									alt=""
									width={720}
									height={480}
									loading="lazy"
									quality={82}
								/>
							) : (
								<img
									src="/images/ysk-life-og.png"
									alt=""
									width="1200"
									height="630"
									loading="lazy"
									decoding="async"
								/>
							)}
						</div>
						<div class="carousel-copy">
							<div class="carousel-meta">
								<span>{post.data.category}</span>
								<FormattedDate date={post.data.pubDate} />
							</div>
							<h3>{post.data.title}</h3>
							<span class="carousel-link">この記事を読む <Icon name="ri:arrow-right-line" aria-hidden="true" /></span>
						</div>
					</a>
				</li>
			))}
		</ol>
	</div>
</div>

<script>
	const initializeArticleCarousels = () => {
		document.querySelectorAll<HTMLElement>('[data-article-carousel]').forEach((carousel) => {
			if (carousel.dataset.carouselReady === 'true') return;

			const viewport = carousel.querySelector<HTMLElement>('[data-carousel-viewport]');
			const items = Array.from(carousel.querySelectorAll<HTMLElement>('[data-carousel-item]'));
			const previousButton = carousel.querySelector<HTMLButtonElement>('[data-carousel-previous]');
			const nextButton = carousel.querySelector<HTMLButtonElement>('[data-carousel-next]');
			const status = carousel.querySelector<HTMLElement>('[data-carousel-status]');

			if (!viewport || !previousButton || !nextButton || !status || items.length === 0) return;

			carousel.dataset.carouselReady = 'true';
			const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
			let updateFrame = 0;

			const getVisibleRange = () => {
				const viewportStart = viewport.scrollLeft;
				const viewportEnd = viewport.scrollLeft + viewport.clientWidth;
				const firstVisibleIndex = items.findIndex(
					(item) => item.offsetLeft + item.offsetWidth / 2 > viewportStart,
				);
				let lastVisibleIndex = firstVisibleIndex;

				items.forEach((item, index) => {
					if (item.offsetLeft + item.offsetWidth / 2 < viewportEnd) lastVisibleIndex = index;
				});

				return {
					first: Math.max(0, firstVisibleIndex),
					last: Math.max(0, lastVisibleIndex),
				};
			};

			const updateControls = () => {
				const maximumScroll = Math.max(0, viewport.scrollWidth - viewport.clientWidth);
				const { first, last } = getVisibleRange();

				previousButton.disabled = viewport.scrollLeft <= 2;
				nextButton.disabled = viewport.scrollLeft >= maximumScroll - 2;
				status.textContent = maximumScroll <= 2
					? `全${items.length}本`
					: `${first + 1}-${last + 1} / ${items.length}本`;
			};

			const queueControlUpdate = () => {
				if (updateFrame) return;
				updateFrame = window.requestAnimationFrame(() => {
					updateFrame = 0;
					updateControls();
				});
			};

			const moveCarousel = (direction: -1 | 1) => {
				const distance = Math.max(items[0].offsetWidth, viewport.clientWidth * 0.86);
				viewport.scrollBy({
					left: direction * distance,
					behavior: reduceMotion ? 'auto' : 'smooth',
				});
			};

			previousButton.addEventListener('click', () => moveCarousel(-1));
			nextButton.addEventListener('click', () => moveCarousel(1));
			viewport.addEventListener('scroll', queueControlUpdate, { passive: true });
			viewport.addEventListener('keydown', (event) => {
				if (event.key === 'ArrowLeft' || event.key === 'ArrowRight') {
					event.preventDefault();
					moveCarousel(event.key === 'ArrowLeft' ? -1 : 1);
				}
				if (event.key === 'Home' || event.key === 'End') {
					event.preventDefault();
					viewport.scrollTo({
						left: event.key === 'Home' ? 0 : viewport.scrollWidth,
						behavior: reduceMotion ? 'auto' : 'smooth',
					});
				}
			});

			const resizeObserver = new ResizeObserver(queueControlUpdate);
			resizeObserver.observe(viewport);
			updateControls();
		});
	};

	initializeArticleCarousels();
</script>

<style>
	.article-carousel {
		min-width: 0;
	}

	.carousel-toolbar {
		display: flex;
		min-height: 3rem;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 1rem;
	}

	.carousel-status {
		margin: 0;
		color: var(--site-muted, var(--muted));
		font-size: 0.78rem;
		font-weight: 750;
		font-variant-numeric: tabular-nums;
	}

	.carousel-controls {
		display: flex;
		gap: 0.55rem;
		visibility: hidden;
	}

	.article-carousel[data-carousel-ready="true"] .carousel-controls {
		visibility: visible;
	}

	.carousel-controls button {
		display: inline-flex;
		width: 2.875rem;
		height: 2.875rem;
		padding: 0;
		align-items: center;
		justify-content: center;
		cursor: pointer;
		border: 1px solid var(--site-text, var(--ink));
		border-radius: 999px;
		background: transparent;
		color: var(--site-text, var(--ink));
		font: inherit;
		transition: transform 160ms ease, background-color 160ms ease, color 160ms ease, opacity 160ms ease;
	}

	.carousel-controls button :global(svg) {
		width: 1.2rem;
		height: 1.2rem;
	}

	.carousel-controls button:hover:not(:disabled) {
		transform: translateY(-2px);
		background: var(--site-text, var(--ink));
		color: var(--site-bg, var(--paper));
	}

	.carousel-controls button:active:not(:disabled) {
		transform: translateY(-1px) scale(0.96);
	}

	.carousel-controls button:disabled {
		cursor: default;
		opacity: 0.34;
	}

	.carousel-viewport {
		overflow-x: auto;
		overflow-y: hidden;
		padding: 0.25rem 0 1.1rem;
		overscroll-behavior-inline: contain;
		scroll-padding-inline: 0;
		scroll-snap-type: inline mandatory;
		scrollbar-width: none;
	}

	.carousel-viewport::-webkit-scrollbar {
		display: none;
	}

	.carousel-track {
		display: grid;
		grid-auto-columns: calc((100% - 2rem) / 3);
		grid-auto-flow: column;
		gap: 1rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.carousel-item {
		min-width: 0;
		scroll-snap-align: start;
	}

	.carousel-item > a {
		display: flex;
		height: 100%;
		min-height: 100%;
		flex-direction: column;
		overflow: hidden;
		border: 1px solid var(--site-line, var(--line));
		border-radius: var(--radius);
		background: var(--site-surface, var(--white));
		color: var(--site-text, var(--ink));
		text-decoration: none;
		transition: transform 180ms ease, border-color 180ms ease, background-color 180ms ease;
	}

	.carousel-image {
		overflow: hidden;
		background: var(--site-surface-subtle, var(--paper-deep));
	}

	.carousel-image :global(img) {
		width: 100%;
		aspect-ratio: 3 / 2;
		object-fit: cover;
		transition: transform 280ms ease;
	}

	.carousel-copy {
		display: flex;
		min-height: 13rem;
		padding: 1.3rem;
		flex: 1;
		flex-direction: column;
	}

	.carousel-meta {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 0.35rem 0.75rem;
		margin-bottom: 0.85rem;
		color: var(--site-muted, var(--muted));
		font-size: 0.7rem;
		font-weight: 750;
	}

	.carousel-copy h3 {
		margin-bottom: 1.2rem;
		font-size: clamp(1.15rem, 1.8vw, 1.5rem);
		line-height: 1.42;
	}

	.carousel-link {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		margin-top: auto;
		font-size: 0.78rem;
		font-weight: 800;
	}

	.carousel-link :global(svg) {
		width: 1rem;
		height: 1rem;
		transition: transform 180ms ease;
	}

	.carousel-item > a:hover {
		transform: translateY(-4px);
		border-color: var(--site-accent, var(--coral));
		color: var(--site-link-hover, var(--olive-dark));
	}

	.carousel-item > a:hover .carousel-image :global(img) {
		transform: scale(1.025);
	}

	.carousel-item > a:hover .carousel-link :global(svg) {
		transform: translateX(0.2rem);
	}

	.carousel-item > a:active {
		transform: translateY(-1px) scale(0.99);
	}

	@media (max-width: 900px) {
		.carousel-track {
			grid-auto-columns: calc((100% - 1rem) / 2);
		}
	}

	@media (max-width: 620px) {
		.carousel-track {
			grid-auto-columns: min(82vw, 22rem);
		}

		.carousel-copy {
			min-height: 11.5rem;
			padding: 1.1rem;
		}

		.carousel-copy h3 {
			font-size: 1.12rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.carousel-viewport {
			scroll-behavior: auto;
		}

		.carousel-controls button,
		.carousel-item > a,
		.carousel-image :global(img),
		.carousel-link :global(svg) {
			transition: none;
		}

		.carousel-item > a:hover,
		.carousel-item > a:active {
			transform: none;
		}
	}
</style>
