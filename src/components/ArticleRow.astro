---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { getBlogGenreLabel } from '../lib/blogNavigation';
import '../styles/article-rows.css';

// 記事の一覧の1件（1行型）。<ul class="article-rows"> の中に置く。
interface Props {
	post: CollectionEntry<'blog'>;
	titleTag?: 'h2' | 'h3' | 'h4' | 'span';
}

const { post, titleTag: TitleTag = 'h3' } = Astro.props;
const date = post.data.pubDate;
const dateText = `${date.getUTCFullYear()}.${String(date.getUTCMonth() + 1).padStart(2, '0')}.${String(date.getUTCDate()).padStart(2, '0')}`;
---

<li>
	<a href={`/blog/${post.id}/`}>
		<span class="row-thumb">
			{post.data.heroImage ? (
				<Image src={post.data.heroImage} alt="" widths={[240, 320]} sizes="(min-width: 760px) 150px, 112px" width={320} height={213} loading="lazy" quality={80} />
			) : (
				<img src="/images/ysk-life-og.png" alt="" width="1200" height="630" loading="lazy" decoding="async" />
			)}
		</span>
		<span class="row-body">
			<span class="row-genre">{getBlogGenreLabel(post.data.category)}</span>
			<TitleTag class="row-title">{post.data.title}</TitleTag>
			<time class="row-date" datetime={date.toISOString()}>{dateText}</time>
		</span>
	</a>
</li>
